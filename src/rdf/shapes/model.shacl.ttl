# ==============================================================================
# PREFIXES USED FOR THIS PROJECT
# ==============================================================================

# Project-specific namespaces/qnames
@prefix :                <https://agriculture.ld.admin.ch/eCH-0309/1/> .


# LINDAS-specific namespaces/qnames
@prefix org:             <https://register.ld.admin.ch/opendataswiss/org/> .
@prefix cube:            <https://cube.link/> .
@prefix meta:            <https://cube.link/meta/> .
@prefix status:          <https://ld.admin.ch/vocabulary/CreativeWorkStatus/> .
@prefix theme:           <https://register.ld.admin.ch/opendataswiss/category/> .

# Globally used namespaces/qnames
@prefix adms:            <https://www.w3.org/ns/adms#> .
@prefix dcat:            <http://www.w3.org/ns/dcat#> .
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix doap:            <http://usefulinc.com/ns/doap#> .
@prefix frequency:       <https://publications.europa.eu/resource/authority/frequency/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix qudt:            <http://qudt.org/schema/qudt/> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:          <http://schema.org/> .
@prefix sh:              <http://www.w3.org/ns/shacl#> .
@prefix unit:            <http://qudt.org/vocab/unit/> .
@prefix vcard:           <http://www.w3.org/2006/vcard/ns#> .
@prefix void:            <http://rdfs.org/ns/void#> .
@prefix wikidata:        <http://www.wikidata.org/entity/> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# SHACL DATA MODEL METADATA
# ==============================================================================

: a owl:Ontology ;
    rdfs:label "eCH-0309-Datenmodell"@de,
        "eCH-0309 data model"@en,
        "modèle de données eCH-0309"@fr,
        "modello di dati eCH-0309"@it ;
    rdfs:comment "Dieses SHACL-Datenmodell beschreibt das Datenmodell aus dem Hilfsmittel eCH-0309 'Tierverkehrsdaten'."@de,
        "This SHACL data model describes the data model from the tool eCH-0309 'Animal Movement Data'."@en,
        "Ce modèle de données SHACL décrit le modèle de données de l'outil eCH-0309 « Données sur le trafic des animaux »."@fr,
        "Questo modello di dati SHACL descrive il modello di dati dello strumento eCH-0309 'Dati sul traffico di animali'."@it ;
    sh:declare [
        sh:prefix "schema" ;
        sh:namespace "http://schema.org/"^^xsd:anyURI ;
    ],
    [
        sh:prefix "" ;
        sh:namespace "https://agriculture.ld.admin.ch/eCH-0309/1/"^^xsd:anyURI ;
    ] .

# ==============================================================================
# NODE SHAPES
#
# Step 1 of the model: the classes of the Objektkatalog (chapter 3.3 of the
# Hilfsmittel) and the associations between them. Literal attributes, code
# lists and the alignment with eCH-0108/eCH-0261 follow in later steps.
#
# Every shape and every property records its provenance with :sourceTerm (the
# term used in the Objektkatalog) and :animalTracingTerm (the corresponding
# schema name in the AnimalTracing/TVD openAPI). Where the openAPI has no
# counterpart, :animalTracingTerm is absent and the fact is stated in the
# rdfs:comment.
# ==============================================================================

:AnimalKeeperShape a sh:NodeShape ;
    rdfs:label "Tierhaltender"@de,
        "Animal keeper"@en,
        "Détenteur d'animaux"@fr,
        "Detentore di animali"@it ;
    rdfs:comment "Eine rechtliche Einheit nach eCH-0108, die Tiere hält (LBV Art. 11a) und dafür eine örtliche Einheit (Tierhaltung) benötigt. Der Tierhaltende trägt die Verantwortung für das Meldewesen aller Tierkategorien mit Ausnahme der Equiden. Die Attribute sind in eCH-0261 beschrieben."@de,
        "A legal unit as defined in eCH-0108 that keeps animals (LBV Art. 11a) and therefore requires a local unit (animal holding). The animal keeper is responsible for reporting for all animal categories except equids. The attributes are described in eCH-0261."@en,
        "Une unité juridique au sens de l'eCH-0108 qui détient des animaux (OTerm art. 11a) et qui nécessite donc une unité locale (unité d'élevage). Le détenteur d'animaux est responsable des notifications pour toutes les catégories d'animaux à l'exception des équidés. Les attributs sont décrits dans l'eCH-0261."@fr,
        "Un'unità giuridica ai sensi dell'eCH-0108 che detiene animali (OTerm art. 11a) e che necessita quindi di un'unità locale (detenzione di animali). Il detentore di animali è responsabile delle notifiche per tutte le categorie di animali ad eccezione degli equidi. Gli attributi sono descritti nell'eCH-0261."@it ;
    :sourceTerm "Tierhaltender" ;
    :animalTracingTerm "LegalUnitOrganisationResponse", "LegalUnitPersonResponse", "FarmManagerV1Response" ;
    sh:targetClass :AnimalKeeper ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:description "Ein Tierhaltender braucht mindestens eine örtliche Einheit (Kapitel 3.1.1 des Hilfsmittels). Diese Regel ist der Semantikbeschreibung entnommen, nicht dem Objektkatalog."@de,
            "An animal keeper requires at least one local unit (chapter 3.1.1 of the tool). This rule is taken from the semantic description, not from the object catalogue."@en,
            "Un détenteur d'animaux a besoin d'au moins une unité locale (chapitre 3.1.1 de l'outil). Cette règle provient de la description sémantique et non du catalogue d'objets."@fr,
            "Un detentore di animali necessita di almeno un'unità locale (capitolo 3.1.1 dello strumento). Questa regola è tratta dalla descrizione semantica e non dal catalogo degli oggetti."@it ;
        sh:message "Ein Tierhaltender muss mindestens einer örtlichen Einheit zugeordnet sein."@de,
            "An animal keeper must be assigned to at least one local unit."@en,
            "Un détenteur d'animaux doit être rattaché à au moins une unité locale."@fr,
            "Un detentore di animali deve essere assegnato ad almeno un'unità locale."@it ;
        sh:prefixes : ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { ?localUnit :animalKeeper $this . }
            }
        """ ;
    ] .

:LocalUnitShape a sh:NodeShape ;
    rdfs:label "Örtliche Einheit"@de,
        "Local unit"@en,
        "Unité locale"@fr,
        "Unità locale"@it ;
    rdfs:comment "Eine Einrichtung an einem bestimmten Ort, an welcher eine wirtschaftliche Tätigkeit ausgeübt wird (eCH-0108). Eine örtliche Einheit wird über die BUR-Nummer identifiziert und ist immer einer rechtlichen Einheit zugeordnet. In der Tierverkehrsdatenbank werden örtliche Einheiten mit einer TVD-Nummer 'Tierhaltungen' genannt. Die Attribute sind in eCH-0261 beschrieben."@de,
        "A facility at a given location where an economic activity is carried out (eCH-0108). A local unit is identified by its BUR number and is always assigned to a legal unit. In the animal movement database, local units holding a TVD number are called 'animal holdings'. The attributes are described in eCH-0261."@en,
        "Une installation située en un lieu déterminé où s'exerce une activité économique (eCH-0108). Une unité locale est identifiée par son numéro REE et est toujours rattachée à une unité juridique. Dans la banque de données sur le trafic des animaux, les unités locales disposant d'un numéro BDTA sont appelées « unités d'élevage ». Les attributs sont décrits dans l'eCH-0261."@fr,
        "Un impianto situato in un luogo determinato in cui viene svolta un'attività economica (eCH-0108). Un'unità locale è identificata dal suo numero RIS ed è sempre assegnata a un'unità giuridica. Nella banca dati sul traffico di animali, le unità locali dotate di un numero BDTA sono chiamate 'detenzioni di animali'. Gli attributi sono descritti nell'eCH-0261."@it ;
    :sourceTerm "örtliche Einheit" ;
    :animalTracingTerm "LocalUnitOwnResponse", "LocalUnitPublicResponse", "FarmDataV1Response" ;
    sh:targetClass :LocalUnit ;
    sh:property [
        sh:order 1 ;
        sh:name "Tierhaltender"@de,
            "Animal keeper"@en,
            "Détenteur d'animaux"@fr,
            "Detentore di animali"@it ;
        :sourceTerm "Tierhaltender" ;
        :animalTracingTerm "LocalUnitOwnResponse.mainUid" ;
        sh:path :animalKeeper ;
        sh:class :AnimalKeeper ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine örtliche Einheit ist immer genau einem Tierhaltenden zugeordnet."@de,
            "A local unit is always assigned to exactly one animal keeper."@en,
            "Une unité locale est toujours rattachée à exactement un détenteur d'animaux."@fr,
            "Un'unità locale è sempre assegnata a esattamente un detentore di animali."@it ;
    ] .

:AnimalShape a sh:NodeShape ;
    rdfs:label "Einzeltier"@de,
        "Individual animal"@en,
        "Animal individuel"@fr,
        "Animale singolo"@it ;
    rdfs:comment "Ein einzeln identifiziertes Nutztier. In der Tierverkehrsdatenbank werden Tiere der Kategorien Rinder, Schafe, Ziegen und Equiden als Einzeltiere erfasst; sie werden über die Ohrmarkennummer, bei Equiden über die UELN, eindeutig identifiziert. Für Schweine und Geflügel werden keine Einzeltiere geführt, sondern ausschliesslich Gruppenmeldungen."@de,
        "An individually identified farm animal. In the animal movement database, animals of the categories cattle, sheep, goats and equids are recorded as individual animals; they are uniquely identified by their ear tag number, or by the UELN in the case of equids. No individual animals are kept for pigs and poultry, only group notifications."@en,
        "Un animal de rente identifié individuellement. Dans la banque de données sur le trafic des animaux, les animaux des catégories bovins, ovins, caprins et équidés sont enregistrés comme animaux individuels ; ils sont identifiés de manière univoque par leur numéro de marque auriculaire, ou par l'UELN pour les équidés. Aucun animal individuel n'est tenu pour les porcs et la volaille, mais uniquement des notifications de groupe."@fr,
        "Un animale da reddito identificato singolarmente. Nella banca dati sul traffico di animali, gli animali delle categorie bovini, ovini, caprini ed equidi sono registrati come animali singoli; sono identificati in modo univoco dal numero della marca auricolare o, per gli equidi, dall'UELN. Per i suini e il pollame non vengono tenuti animali singoli, ma esclusivamente notifiche di gruppo."@it ;
    :sourceTerm "Einzeltier" ;
    :animalTracingTerm "CattleDetailV1Response", "SheepDetailV1Response", "GoatDetailV1Response" ;
    sh:targetClass :Animal ;
    sh:property [
        sh:order 1 ;
        sh:name "Identifikation Mutter"@de,
            "Mother"@en,
            "Mère"@fr,
            "Madre"@it ;
        :sourceTerm "Identifikation Mutter" ;
        :animalTracingTerm "CattleDetailV1ParentageResponse.motherEartagNumber" ;
        sh:path :mother ;
        sh:class :Animal ;
        sh:maxCount 1 ;
        sh:message "Ein Einzeltier hat höchstens ein Muttertier."@de,
            "An individual animal has at most one mother animal."@en,
            "Un animal individuel a au plus une mère."@fr,
            "Un animale singolo ha al massimo una madre."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Identifikation Vater"@de,
            "Father"@en,
            "Père"@fr,
            "Padre"@it ;
        :sourceTerm "Identifikation Vater" ;
        :animalTracingTerm "CattleDetailV1ParentageResponse.fatherEartagNumber" ;
        sh:path :father ;
        sh:class :Animal ;
        sh:maxCount 1 ;
        sh:message "Ein Einzeltier hat höchstens ein Vatertier."@de,
            "An individual animal has at most one father animal."@en,
            "Un animal individuel a au plus un père."@fr,
            "Un animale singolo ha al massimo un padre."@it ;
    ] .

:EquidShape a sh:NodeShape ;
    rdfs:label "Equide"@de,
        "Equid"@en,
        "Équidé"@fr,
        "Equide"@it ;
    rdfs:comment "Subklasse der Klasse Einzeltier für Tiere der Gattung Equiden (Pferd, Maultier, Maulesel, Esel). Alle Attribute der Klasse Einzeltier gelten auch für Equiden; diese Klasse beschreibt ausschliesslich die zusätzlichen, equidenspezifischen Angaben. Die Verantwortung für das Meldewesen liegt bei Equiden nicht beim Tierhaltenden, sondern bei der Eigentümerin oder beim Eigentümer."@de,
        "Subclass of the class individual animal for animals of the equid genus (horse, mule, hinny, donkey). All attributes of the class individual animal also apply to equids; this class describes only the additional, equid-specific information. For equids, responsibility for reporting lies with the owner rather than with the animal keeper."@en,
        "Sous-classe de la classe animal individuel pour les animaux du genre équidé (cheval, mulet, bardot, âne). Tous les attributs de la classe animal individuel s'appliquent également aux équidés ; cette classe ne décrit que les informations supplémentaires propres aux équidés. Pour les équidés, la responsabilité des notifications incombe au propriétaire et non au détenteur d'animaux."@fr,
        "Sottoclasse della classe animale singolo per gli animali del genere equide (cavallo, mulo, bardotto, asino). Tutti gli attributi della classe animale singolo si applicano anche agli equidi; questa classe descrive esclusivamente le informazioni aggiuntive specifiche degli equidi. Per gli equidi la responsabilità delle notifiche spetta al proprietario e non al detentore di animali."@it ;
    :sourceTerm "Equiden" ;
    :animalTracingTerm "EquidDetailsEquidResponse", "EquidDetailsPublicEquidResponse" ;
    sh:targetClass :Equid .

:AnimalNotificationShape a sh:NodeShape ;
    rdfs:label "Meldung Einzeltier"@de,
        "Individual animal notification"@en,
        "Notification d'animal individuel"@fr,
        "Notifica di animale singolo"@it ;
    rdfs:comment "Ein Ereignis, das ein Einzeltier betrifft. Als Ereignisse gelten Bewegungsmeldungen, Meldungen von Grunddaten, Änderungen einzelner Attribute der Grunddaten sowie finale Meldungen. Eine Meldung bezieht sich immer auf die örtliche Einheit, auf welcher das Ereignis stattgefunden hat, und kann zusätzlich die örtliche Einheit der Herkunft angeben."@de,
        "An event concerning an individual animal. Events comprise movement notifications, notifications of basic data, changes to individual attributes of the basic data as well as final notifications. A notification always refers to the local unit at which the event took place and may in addition state the local unit of origin."@en,
        "Un événement concernant un animal individuel. Sont considérées comme événements les notifications de mouvement, les notifications de données de base, les modifications d'attributs individuels des données de base ainsi que les notifications finales. Une notification se rapporte toujours à l'unité locale où l'événement a eu lieu et peut en outre indiquer l'unité locale de provenance."@fr,
        "Un evento che riguarda un animale singolo. Sono considerati eventi le notifiche di movimento, le notifiche di dati di base, le modifiche di singoli attributi dei dati di base nonché le notifiche finali. Una notifica si riferisce sempre all'unità locale in cui si è verificato l'evento e può inoltre indicare l'unità locale di provenienza."@it ;
    :sourceTerm "Meldung Einzeltier" ;
    :animalTracingTerm "CattleDetailV1NotificationResponse", "SheepDetailV1NotificationResponse", "GoatDetailV1NotificationResponse" ;
    sh:targetClass :AnimalNotification ;
    sh:property [
        sh:order 1 ;
        sh:name "Einzeltier"@de,
            "Individual animal"@en,
            "Animal individuel"@fr,
            "Animale singolo"@it ;
        :sourceTerm "Identifikator" ;
        :animalTracingTerm "CattleDetailV1Response.eartagNumber" ;
        sh:path :animal ;
        sh:class :Animal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine Meldung Einzeltier bezieht sich auf genau ein Einzeltier."@de,
            "An individual animal notification refers to exactly one individual animal."@en,
            "Une notification d'animal individuel se rapporte à exactement un animal individuel."@fr,
            "Una notifica di animale singolo si riferisce a esattamente un animale singolo."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Örtliche Einheit"@de,
            "Local unit"@en,
            "Unité locale"@fr,
            "Unità locale"@it ;
        :sourceTerm "Örtliche Einheit" ;
        :animalTracingTerm "CattleDetailV1NotificationResponse.localId" ;
        sh:path :localUnit ;
        sh:class :LocalUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine Meldung Einzeltier bezieht sich auf genau eine örtliche Einheit."@de,
            "An individual animal notification refers to exactly one local unit."@en,
            "Une notification d'animal individuel se rapporte à exactement une unité locale."@fr,
            "Una notifica di animale singolo si riferisce a esattamente un'unità locale."@it ;
    ],
    [
        sh:order 3 ;
        sh:name "Herkunft"@de,
            "Origin"@en,
            "Provenance"@fr,
            "Provenienza"@it ;
        :sourceTerm "Herkunft" ;
        :animalTracingTerm "CattleDetailV1StaysArrivalNotificationResponse.originLocalId" ;
        sh:path :originLocalUnit ;
        sh:class :LocalUnit ;
        sh:maxCount 1 ;
        sh:message "Eine Meldung Einzeltier gibt höchstens eine örtliche Einheit als Herkunft an."@de,
            "An individual animal notification states at most one local unit as its origin."@en,
            "Une notification d'animal individuel indique au plus une unité locale comme provenance."@fr,
            "Una notifica di animale singolo indica al massimo un'unità locale come provenienza."@it ;
    ] .

:GroupNotificationShape a sh:NodeShape ;
    rdfs:label "Gruppenmeldung"@de,
        "Group notification"@en,
        "Notification de groupe"@fr,
        "Notifica di gruppo"@it ;
    rdfs:comment "Ein Ereignis für eine nicht eindeutig identifizierbare Tiergruppe. Gruppenmeldungen werden für Tiere der Kategorien Schweine und Geflügel erfasst; die Individuen einer Tiergruppe sind deshalb nicht bekannt. Für diese Klasse besteht in der openAPI-Spezifikation von AnimalTracing kein Gegenstück, da Schweine und Geflügel dort nicht abgebildet sind."@de,
        "An event concerning a group of animals that cannot be identified individually. Group notifications are recorded for animals of the categories pigs and poultry; the individuals of such a group are therefore not known. This class has no counterpart in the AnimalTracing openAPI specification, because pigs and poultry are not covered there."@en,
        "Un événement concernant un groupe d'animaux qui ne peuvent pas être identifiés individuellement. Les notifications de groupe sont enregistrées pour les animaux des catégories porcs et volaille ; les individus d'un tel groupe ne sont donc pas connus. Cette classe n'a pas d'équivalent dans la spécification openAPI d'AnimalTracing, car les porcs et la volaille n'y sont pas représentés."@fr,
        "Un evento che riguarda un gruppo di animali non identificabili singolarmente. Le notifiche di gruppo sono registrate per gli animali delle categorie suini e pollame; gli individui di un tale gruppo non sono pertanto noti. Questa classe non ha alcun corrispettivo nella specifica openAPI di AnimalTracing, poiché i suini e il pollame non vi sono rappresentati."@it ;
    :sourceTerm "Gruppenmeldung" ;
    sh:targetClass :GroupNotification ;
    sh:property [
        sh:order 1 ;
        sh:name "Örtliche Einheit"@de,
            "Local unit"@en,
            "Unité locale"@fr,
            "Unità locale"@it ;
        :sourceTerm "Örtliche Einheit" ;
        sh:path :localUnit ;
        sh:class :LocalUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine Gruppenmeldung bezieht sich auf genau eine örtliche Einheit."@de,
            "A group notification refers to exactly one local unit."@en,
            "Une notification de groupe se rapporte à exactement une unité locale."@fr,
            "Una notifica di gruppo si riferisce a esattamente un'unità locale."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Herkunft"@de,
            "Origin"@en,
            "Provenance"@fr,
            "Provenienza"@it ;
        :sourceTerm "Herkunft" ;
        sh:path :originLocalUnit ;
        sh:class :LocalUnit ;
        sh:maxCount 1 ;
        sh:message "Eine Gruppenmeldung gibt höchstens eine örtliche Einheit als Herkunft an."@de,
            "A group notification states at most one local unit as its origin."@en,
            "Une notification de groupe indique au plus une unité locale comme provenance."@fr,
            "Una notifica di gruppo indica al massimo un'unità locale come provenienza."@it ;
    ] .

:LocalUnitHealthStatusShape a sh:NodeShape ;
    rdfs:label "Gesundheitsstatus Standort"@de,
        "Health status of a local unit"@en,
        "État sanitaire de l'unité locale"@fr,
        "Stato sanitario dell'unità locale"@it ;
    rdfs:comment "Eine Seucheninformation, die auf einer örtlichen Einheit erfasst ist. Neben dem Seuchenstatus einer örtlichen Einheit können auch Impf-, Risiko- und Laborergebnisse abgebildet werden. In der openAPI-Spezifikation von AnimalTracing besteht dafür keine eigene Klasse; die entsprechenden Angaben sind dort Attribute der örtlichen Einheit."@de,
        "Disease information recorded for a local unit. In addition to the epizootic status of a local unit, vaccination, risk and laboratory results can also be represented. The AnimalTracing openAPI specification has no dedicated class for this; there the corresponding information is held as attributes of the local unit."@en,
        "Une information épizootique enregistrée sur une unité locale. Outre le statut épizootique d'une unité locale, les résultats de vaccination, de risque et de laboratoire peuvent également être représentés. La spécification openAPI d'AnimalTracing ne prévoit pas de classe distincte à cet effet ; les informations correspondantes y sont des attributs de l'unité locale."@fr,
        "Un'informazione epizootica registrata su un'unità locale. Oltre allo stato epizootico di un'unità locale, possono essere rappresentati anche i risultati di vaccinazione, di rischio e di laboratorio. La specifica openAPI di AnimalTracing non prevede una classe distinta a tal fine; le informazioni corrispondenti vi figurano come attributi dell'unità locale."@it ;
    :sourceTerm "Gesundheitsstatus Standort" ;
    sh:targetClass :LocalUnitHealthStatus ;
    sh:property [
        sh:order 1 ;
        sh:name "Örtliche Einheit"@de,
            "Local unit"@en,
            "Unité locale"@fr,
            "Unità locale"@it ;
        :sourceTerm "Örtliche Einheit" ;
        :animalTracingTerm "LocalUnitPublicResponse.bvdState", "LocalUnitPublicResponse.footRotState" ;
        sh:path :localUnit ;
        sh:class :LocalUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ein Gesundheitsstatus Standort bezieht sich auf genau eine örtliche Einheit."@de,
            "A health status of a local unit refers to exactly one local unit."@en,
            "Un état sanitaire de l'unité locale se rapporte à exactement une unité locale."@fr,
            "Uno stato sanitario dell'unità locale si riferisce a esattamente un'unità locale."@it ;
    ] .

:AnimalHealthStatusShape a sh:NodeShape ;
    rdfs:label "Gesundheitsstatus Einzeltier"@de,
        "Health status of an individual animal"@en,
        "État sanitaire de l'animal individuel"@fr,
        "Stato sanitario dell'animale singolo"@it ;
    rdfs:comment "Eine Seucheninformation, die auf einem Einzeltier erfasst ist. Zusätzlich zum individuellen Seuchenstatus werden damit auch relevante Impfungen erfasst."@de,
        "Disease information recorded for an individual animal. In addition to the individual epizootic status, relevant vaccinations are recorded as well."@en,
        "Une information épizootique enregistrée sur un animal individuel. Outre le statut épizootique individuel, les vaccinations pertinentes sont également enregistrées."@fr,
        "Un'informazione epizootica registrata su un animale singolo. Oltre allo stato epizootico individuale, vengono registrate anche le vaccinazioni rilevanti."@it ;
    :sourceTerm "Gesundheitsstatus Einzeltier" ;
    :animalTracingTerm "CattleDetailV1DiseasesResponse" ;
    sh:targetClass :AnimalHealthStatus ;
    sh:property [
        sh:order 1 ;
        sh:name "Einzeltier"@de,
            "Individual animal"@en,
            "Animal individuel"@fr,
            "Animale singolo"@it ;
        :sourceTerm "Tier-ID" ;
        :animalTracingTerm "CattleDetailV1Response.eartagNumber" ;
        sh:path :animal ;
        sh:class :Animal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ein Gesundheitsstatus Einzeltier bezieht sich auf genau ein Einzeltier."@de,
            "A health status of an individual animal refers to exactly one individual animal."@en,
            "Un état sanitaire de l'animal individuel se rapporte à exactement un animal individuel."@fr,
            "Uno stato sanitario dell'animale singolo si riferisce a esattamente un animale singolo."@it ;
    ] .
