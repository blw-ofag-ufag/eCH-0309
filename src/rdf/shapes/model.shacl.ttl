# ==============================================================================
# SHACL DATA MODEL METADATA
# ==============================================================================

: a owl:Ontology ;
    rdfs:label "eCH-0309-Datenmodell"@de,
        "eCH-0309 data model"@en,
        "modèle de données eCH-0309"@fr,
        "modello di dati eCH-0309"@it ;
    rdfs:comment "Dieses SHACL-Datenmodell beschreibt das Datenmodell aus dem Hilfsmittel eCH-0309 'Tierverkehrsdaten'."@de,
        "This SHACL data model describes the data model from the tool eCH-0309 'Animal Movement Data'."@en,
        "Ce modèle de données SHACL décrit le modèle de données de l'outil eCH-0309 « Données sur le trafic des animaux »."@fr,
        "Questo modello di dati SHACL descrive il modello di dati dello strumento eCH-0309 'Dati sul traffico di animali'."@it ;
    sh:declare [
        sh:prefix "schema" ;
        sh:namespace "http://schema.org/"^^xsd:anyURI ;
    ],
    [
        sh:prefix "" ;
        sh:namespace "https://agriculture.ld.admin.ch/eCH-0309/1/"^^xsd:anyURI ;
    ],
    [
        sh:prefix "genus" ;
        sh:namespace "https://agriculture.ld.admin.ch/eCH-0309/1/genus/"^^xsd:anyURI ;
    ] .

# ==============================================================================
# NODE SHAPES
#
# One shape per class of the Objektkatalog (chapter 3.3 of the Hilfsmittel),
# :LegalUnitShape, which the Semantikbeschreibung describes but the catalogue
# does not list, and :RuminantShape. The catalogue lists the attributes of
# cattle, sheep and goats under «Einzeltier» and notes those that equids lack;
# the model moves them to a subclass of their own, so that «Einzeltier» holds
# only what all individual animals share. The catalogue's «Gesundheitsstatus
# Standort» is not a class: as in AnimalTracing, the local unit carries one
# status per disease.
#
# The German rdfs:label and sh:name are the Hilfsmittel's own wording.
# :animalTracingTerm records the counterpart in AnimalTracing and :echTerm the
# one in eCH-0108 or eCH-0261; a missing annotation means that source has no
# counterpart, which the rdfs:comment then says.
#
# sh:order on a node shape sets the order of the classes in chapter 3 of the
# documentation; it follows the Objektkatalog.
#
# Points still to be settled with the Fachgruppe are tracked as issues, not
# recorded here.
# ==============================================================================

:LegalUnitShape a sh:NodeShape ;
    rdfs:label "Rechtliche Einheit"@de,
        "Legal unit"@en,
        "Unité juridique"@fr,
        "Unità giuridica"@it ;
    rdfs:comment "Die rechtliche Einheit nach eCH-0108 ist eine juristische Person (z.B. Aktiengesellschaft, GmbH), eine Personengesellschaft (z.B. Kollektivgesellschaft) oder eine selbstständigerwerbende natürliche Person, die dem Bundesgesetz über die Unternehmens-Identifikationsnummer (UIDG) unterstellt ist und einen Eintrag im UID-Register aufweist. Sie identifiziert z.B. das Steuersubjekt für Steuerbehörden oder die beitragspflichtige Person für Sozialversicherungsbeiträge. Die rechtliche Einheit wird mit der UID identifiziert. Nur wenn das Unternehmen ein «Einzelunternehmen» ist, ist der Bewirtschafter zugleich eine natürliche Person. Das Mastersystem für diese Daten ist das UID-Register des BFS; das landwirtschaftliche Informationssystem bezieht die Daten aus diesem Register über eine Schnittstelle. Der Tierhaltende und der Equideneigentümer sind die beiden Ausprägungen der rechtlichen Einheit, die in diesem Hilfsmittel vorkommen. Die Attribute sind in [eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), Kapitel 3.1 und 3.2, sowie in [eCH-0108](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2023-12-21_eCH-0108_V6.0.0_Unternehmensstammdaten%20Unternehmensregister.pdf), Kapitel 3.1, beschrieben."@de,
        "A legal unit as defined in eCH-0108 is a legal entity (e.g. a public limited company or a limited liability company), a partnership (e.g. a general partnership) or a self-employed natural person that is subject to the federal act on the business identification number (UIDG) and has an entry in the UID register. It identifies, for example, the taxable entity for the tax authorities or the person liable for social insurance contributions. The legal unit is identified by its UID. Only where the enterprise is a «sole proprietorship» is the farm manager at the same time a natural person. The master system for this data is the FSO's UID register; the agricultural information system obtains the data from that register through an interface. The animal keeper and the equid owner are the two forms of legal unit that occur in this document. The attributes are described in [eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), chapters 3.1 and 3.2, and in [eCH-0108](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2023-12-21_eCH-0108_V6.0.0_Unternehmensstammdaten%20Unternehmensregister.pdf), chapter 3.1."@en,
        "L'unité juridique au sens de l'eCH-0108 est une personne morale (p. ex. société anonyme, Sàrl), une société de personnes (p. ex. société en nom collectif) ou une personne physique exerçant une activité indépendante qui est soumise à la loi fédérale sur le numéro d'identification des entreprises (LIDE) et qui est inscrite au registre IDE. Elle identifie par exemple le sujet fiscal pour les autorités fiscales ou la personne assujettie aux cotisations d'assurances sociales. L'unité juridique est identifiée par son IDE. Ce n'est que lorsque l'entreprise est une «entreprise individuelle» que l'exploitant est en même temps une personne physique. Le système maître de ces données est le registre IDE de l'OFS ; le système d'information agricole obtient les données de ce registre via une interface. Le détenteur d'animaux et le propriétaire d'équidés sont les deux formes d'unité juridique qui apparaissent dans le présent document. Les attributs sont décrits dans l'[eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), chapitres 3.1 et 3.2, ainsi que dans l'[eCH-0108](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2023-12-21_eCH-0108_V6.0.0_Unternehmensstammdaten%20Unternehmensregister.pdf), chapitre 3.1."@fr,
        "L'unità giuridica ai sensi dell'eCH-0108 è una persona giuridica (p. es. società anonima, Sagl), una società di persone (p. es. società in nome collettivo) o una persona fisica che esercita un'attività indipendente, soggetta alla legge federale sul numero d'identificazione delle imprese (LIDI) e iscritta nel registro IDI. Essa identifica ad esempio il soggetto fiscale per le autorità fiscali o la persona tenuta a versare i contributi alle assicurazioni sociali. L'unità giuridica è identificata dal suo IDI. Soltanto se l'impresa è una «ditta individuale» il gestore è al contempo una persona fisica. Il sistema master di questi dati è il registro IDI dell'UST; il sistema d'informazione agricolo ottiene i dati da tale registro tramite un'interfaccia. Il detentore di animali e il proprietario di equidi sono le due forme di unità giuridica che compaiono in questo documento. Gli attributi sono descritti nell'[eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), capitoli 3.1 e 3.2, e nell'[eCH-0108](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2023-12-21_eCH-0108_V6.0.0_Unternehmensstammdaten%20Unternehmensregister.pdf), capitolo 3.1."@it ;
    # The Objektkatalog has no «rechtliche Einheit» block; this class comes from
    # the Semantikbeschreibung, chapter 3.1.1, whose heading reads
    # "Rechtliche Einheit Tierhalter und Eigentümer".
    :animalTracingTerm "LegalUnitOrganisationResponse", "LegalUnitPersonResponse" ;
    :echTerm "eCH-0108:legalUnitMasterDataType", "eCH-0261:legalUnitType" ;
    sh:order 1 ;
    sh:targetClass :LegalUnit .

:AnimalKeeperShape a sh:NodeShape ;
    rdfs:label "Tierhaltender"@de,
        "Animal keeper"@en,
        "Détenteur d'animaux"@fr,
        "Detentore di animali"@it ;
    rdfs:comment "Ein Bewirtschafter ist eine rechtliche Einheit nach eCH-0108, die das Geschäftsrisiko für einen Betrieb trägt (LBV Art. 2). Der Tierhaltende ist eine Form des Bewirtschafters, der Tiere hält (LBV Art. 11a); er braucht somit eine örtliche Einheit (Tierhaltung). Die Verantwortung für das Meldewesen obliegt dem Tierhaltenden für alle Tierkategorien mit Ausnahme der Equiden; bei Equiden liegt sie beim Eigentümer oder bei der Eigentümerin. Die Attribute sind in [eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), Kapitel 3.1 und 3.2, beschrieben."@de,
        "A farm manager (Bewirtschafter) is a legal unit as defined in eCH-0108 that bears the business risk for a farm (LBV Art. 2). The animal keeper is a form of farm manager that keeps animals (LBV Art. 11a) and therefore requires a local unit (animal holding). Responsibility for reporting lies with the animal keeper for all animal categories except equids; for equids it lies with the owner. The attributes are described in [eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), chapters 3.1 and 3.2."@en,
        "Un exploitant est une unité juridique au sens de l'eCH-0108 qui assume le risque économique d'une exploitation (OTerm art. 2). Le détenteur d'animaux est une forme d'exploitant qui détient des animaux (OTerm art. 11a) ; il lui faut donc une unité locale (unité d'élevage). La responsabilité des notifications incombe au détenteur d'animaux pour toutes les catégories d'animaux à l'exception des équidés ; pour les équidés, elle incombe au propriétaire ou à la propriétaire. Les attributs sont décrits dans l'[eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), chapitres 3.1 et 3.2."@fr,
        "Un gestore è un'unità giuridica ai sensi dell'eCH-0108 che si assume il rischio aziendale di un'azienda (OTerm art. 2). Il detentore di animali è una forma di gestore che detiene animali (OTerm art. 11a); necessita quindi di un'unità locale (detenzione di animali). La responsabilità delle notifiche spetta al detentore di animali per tutte le categorie di animali ad eccezione degli equidi; per gli equidi spetta al proprietario o alla proprietaria. Gli attributi sono descritti nell'[eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), capitoli 3.1 e 3.2."@it ;
    :animalTracingTerm "LegalUnitOrganisationResponse", "LegalUnitPersonResponse", "FarmManagerV1Response" ;
    :echTerm "eCH-0108:legalUnitMasterDataType", "eCH-0261:legalUnitType" ;
    sh:order 2 ;
    sh:targetClass :AnimalKeeper .

:LocalUnitShape a sh:NodeShape ;
    rdfs:label "Örtliche Einheit"@de,
        "Local unit"@en,
        "Unité locale"@fr,
        "Unità locale"@it ;
    rdfs:comment "Eine örtliche Einheit nach eCH-0108 ist eine Einrichtung an einem bestimmten Ort, an welcher eine wirtschaftliche Tätigkeit ausgeübt wird. Eine örtliche Einheit hat eine BUR-Nummer und ist immer einer rechtlichen Einheit (bzw. einem Unternehmen) zugeordnet. Die örtliche Einheit wird über die BUR-Nummer identifiziert. Die örtliche Einheit kann aus einem oder mehreren Gebäuden bestehen. Die der BUR-Nummer zugewiesene EGID bezieht sich auf «das Zentrum» der örtlichen Einheit, resp. das Hauptgebäude. Diese Definition stammt aus [eCH-0108](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2023-12-21_eCH-0108_V6.0.0_Unternehmensstammdaten%20Unternehmensregister.pdf), Kapitel 1.5; die agrarspezifischen Ergänzungen sind in [eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), Kapitel 3.3 und 3.4, beschrieben. In der TVD werden die örtlichen Einheiten «Tierhaltungen» genannt und sind zusätzlich über die TVD-Nummer identifiziert."@de,
        "A local unit as defined in eCH-0108 is a facility at a given location where an economic activity is carried out. A local unit has a BUR number and is always assigned to a legal unit (or enterprise). The local unit is identified by its BUR number. A local unit may consist of one or more buildings. The EGID assigned to the BUR number refers to «the centre» of the local unit, that is, its main building. This definition is taken from [eCH-0108](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2023-12-21_eCH-0108_V6.0.0_Unternehmensstammdaten%20Unternehmensregister.pdf), chapter 1.5; the agriculture-specific additions are described in [eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), chapters 3.3 and 3.4. In the TVD, local units are called «animal holdings» and are additionally identified by their TVD number."@en,
        "Une unité locale au sens de l'eCH-0108 est une installation située en un lieu déterminé où s'exerce une activité économique. Une unité locale possède un numéro REE et est toujours rattachée à une unité juridique (ou entreprise). L'unité locale est identifiée par son numéro REE. Une unité locale peut se composer d'un ou de plusieurs bâtiments. L'EGID attribué au numéro REE se rapporte au «centre» de l'unité locale, respectivement à son bâtiment principal. Cette définition est tirée de l'[eCH-0108](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2023-12-21_eCH-0108_V6.0.0_Unternehmensstammdaten%20Unternehmensregister.pdf), chapitre 1.5 ; les compléments spécifiques à l'agriculture sont décrits dans l'[eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), chapitres 3.3 et 3.4. Dans la BDTA, les unités locales sont appelées «unités d'élevage» et sont en outre identifiées par leur numéro BDTA."@fr,
        "Un'unità locale ai sensi dell'eCH-0108 è un impianto situato in un luogo determinato in cui viene svolta un'attività economica. Un'unità locale possiede un numero RIS ed è sempre assegnata a un'unità giuridica (o impresa). L'unità locale è identificata dal suo numero RIS. Un'unità locale può essere composta da uno o più edifici. L'EGID attribuito al numero RIS si riferisce al «centro» dell'unità locale, rispettivamente al suo edificio principale. Questa definizione è tratta dall'[eCH-0108](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2023-12-21_eCH-0108_V6.0.0_Unternehmensstammdaten%20Unternehmensregister.pdf), capitolo 1.5; i complementi specifici per l'agricoltura sono descritti nell'[eCH-0261](https://ech.ch/sites/default/files/imce/eCH-Dossier/eCH-Dossier_PDF_Publikationen/Hauptdokument/STAN_d_DEF_2024-02_07_eCH-0261_V1.0.0_Datenstandard_Agrardaten_Stammdaten.pdf), capitoli 3.3 e 3.4. Nella BDTA le unità locali sono chiamate «detenzioni di animali» e sono inoltre identificate dal loro numero BDTA."@it ;
    :animalTracingTerm "LocalUnitOwnResponse", "LocalUnitPublicResponse", "FarmDataV1Response" ;
    :echTerm "eCH-0108:localUnitMasterDataType", "eCH-0261:localUnitType" ;
    sh:order 3 ;
    sh:targetClass :LocalUnit ;
    sh:property [
        sh:order 1 ;
        sh:name "Tierhaltender"@de,
            "Animal keeper"@en,
            "Détenteur d'animaux"@fr,
            "Detentore di animali"@it ;
        # Not an Objektkatalog row: the catalogue's «örtliche Einheit» block
        # refers to eCH-0261 for every attribute. See also issue #12.
        :animalTracingTerm "LocalUnitOwnResponse.mainUid" ;
        :echTerm "eCH-0108:localUnitMasterDataType/mainUid" ;
        sh:description "Zuordnung der örtlichen Einheit zum Tierhaltenden. Nach eCH-0108, Kapitel 1.5, ist eine örtliche Einheit immer einer rechtlichen Einheit (bzw. einem Unternehmen) zugeordnet; die Stammdaten der örtlichen Einheit führen dafür das optionale Merkmal «mainUid» mit der UID der rechtlichen Haupteinheit. Da der Tierhaltende nur eine Sonderform der rechtlichen Einheit ist, ist diese Zuordnung nicht zwingend."@de,
            "Assignment of the local unit to the animal keeper. According to eCH-0108, chapter 1.5, a local unit is always assigned to a legal unit (or enterprise); the master data of the local unit carries the optional attribute «mainUid» holding the UID of the main legal unit. Because the animal keeper is only a special form of the legal unit, this assignment is not mandatory."@en,
            "Rattachement de l'unité locale au détenteur d'animaux. Selon l'eCH-0108, chapitre 1.5, une unité locale est toujours rattachée à une unité juridique (ou entreprise) ; les données de base de l'unité locale comportent à cet effet l'attribut facultatif «mainUid» contenant l'IDE de l'unité juridique principale. Le détenteur d'animaux n'étant qu'une forme particulière de l'unité juridique, ce rattachement n'est pas obligatoire."@fr,
            "Assegnazione dell'unità locale al detentore di animali. Secondo l'eCH-0108, capitolo 1.5, un'unità locale è sempre assegnata a un'unità giuridica (o impresa); i dati di base dell'unità locale riportano a tal fine l'attributo facoltativo «mainUid» con l'IDI dell'unità giuridica principale. Poiché il detentore di animali è soltanto una forma particolare dell'unità giuridica, questa assegnazione non è obbligatoria."@it ;
        sh:path :animalKeeper ;
        sh:class :AnimalKeeper ;
        sh:maxCount 1 ;
        sh:message "Eine örtliche Einheit ist höchstens einem Tierhaltenden zugeordnet."@de,
            "A local unit is assigned to at most one animal keeper."@en,
            "Une unité locale est rattachée à au plus un détenteur d'animaux."@fr,
            "Un'unità locale è assegnata al massimo a un detentore di animali."@it ;
    ] ;
    # The health status of a local unit, as AnimalTracing holds it: one field
    # per disease on the local unit itself. The values are the enum members;
    # their names and meanings are not published (GetEnumeration).
    sh:property
    [
        sh:order 2 ;
        sh:name "BVD-Status"@de,
            "BVD status"@en,
            "Statut BVD"@fr,
            "Stato BVD"@it ;
        :animalTracingTerm "BvdState" ;
        sh:description "BVD-Status der örtlichen Einheit, für die Gattung Rinder."@de,
            "BVD status of the local unit, for the genus cattle."@en,
            "Statut BVD de l'unité locale, pour le genre bovins."@fr,
            "Stato BVD dell'unità locale, per il genere bovini."@it ;
        sh:path :bvdState ;
        sh:datatype xsd:string ;
        sh:in ( "Undefined" "Blocked" "AnimalBlocked" "NotBlocked" "ConditionalBlocked" "BvdFree" "NotBvdFree" "NotBvdFreeBlocked" ) ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 3 ;
        sh:name "Moderhinkestatus"@de,
            "Footrot status"@en,
            "Statut piétin"@fr,
            "Stato zoppina"@it ;
        :animalTracingTerm "FootRotState" ;
        sh:description "Moderhinkestatus der örtlichen Einheit, für die Gattung Schafe."@de,
            "Footrot status of the local unit, for the genus sheep."@en,
            "Statut piétin de l'unité locale, pour le genre ovins."@fr,
            "Stato zoppina dell'unità locale, per il genere ovini."@it ;
        sh:path :footRotState ;
        sh:datatype xsd:string ;
        sh:in ( "Undefined" "Free" "NotTested" "Blocked" ) ;
        sh:maxCount 1 ;
    ] .

:AnimalShape a sh:NodeShape ;
    rdfs:label "Einzeltier"@de,
        "Individual animal"@en,
        "Animal individuel"@fr,
        "Animale singolo"@it ;
    rdfs:comment "Ein einzeln identifiziertes Nutztier. In der Tierverkehrsdatenbank werden Tiere der Kategorien Rinder, Schafe, Ziegen und Equiden als Einzeltiere erfasst; sie werden über die Ohrmarkennummer, bei Equiden über die UELN, eindeutig identifiziert. Für Schweine und Geflügel werden keine Einzeltiere geführt, sondern ausschliesslich Gruppenmeldungen. Jedes Einzeltier ist entweder ein Wiederkäuer (Rind, Schaf, Ziege) oder ein Equide; diese Klasse beschreibt die Angaben, die für beide gelten."@de,
        "An individually identified farm animal. In the animal movement database, animals of the categories cattle, sheep, goats and equids are recorded as individual animals; they are uniquely identified by their ear tag number, or by the UELN in the case of equids. No individual animals are kept for pigs and poultry, only group notifications. Every individual animal is either a ruminant (cattle, sheep, goat) or an equid; this class describes the information that applies to both."@en,
        "Un animal de rente identifié individuellement. Dans la banque de données sur le trafic des animaux, les animaux des catégories bovins, ovins, caprins et équidés sont enregistrés comme animaux individuels ; ils sont identifiés de manière univoque par leur numéro de marque auriculaire, ou par l'UELN pour les équidés. Aucun animal individuel n'est tenu pour les porcs et la volaille, mais uniquement des notifications de groupe. Chaque animal individuel est soit un ruminant (bovin, ovin, caprin), soit un équidé ; cette classe décrit les informations qui valent pour les deux."@fr,
        "Un animale da reddito identificato singolarmente. Nella banca dati sul traffico di animali, gli animali delle categorie bovini, ovini, caprini ed equidi sono registrati come animali singoli; sono identificati in modo univoco dal numero della marca auricolare o, per gli equidi, dall'UELN. Per i suini e il pollame non vengono tenuti animali singoli, ma esclusivamente notifiche di gruppo. Ogni animale singolo è un ruminante (bovino, ovino, caprino) oppure un equide; questa classe descrive le informazioni che valgono per entrambi."@it ;
    sh:order 4 ;
    sh:targetClass :Animal ;
    sh:property
    [
        sh:order 2 ;
        sh:name "Identifikator"@de,
            "Identifier"@en,
            "Identifiant"@fr,
            "Identificatore"@it ;
        sh:description "Ohrmarkennummer, bei Equiden UELN"@de,
            "Ear tag number, or UELN for equids"@en,
            "Numéro de marque auriculaire, UELN pour les équidés"@fr,
            "Numero della marca auricolare, UELN per gli equidi"@it ;
        sh:path :identifier ;
        sh:datatype xsd:string ;
        sh:maxLength 15 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 3 ;
        sh:name "Nutztierart"@de,
            "Genus"@en,
            "Espèce d'animal de rente"@fr,
            "Specie di animale da reddito"@it ;
        :animalTracingTerm "EnumGenus" ;
        sh:path :genus ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:Genus ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 4 ;
        sh:name "Geschlecht"@de,
            "Gender"@en,
            "Sexe"@fr,
            "Sesso"@it ;
        :animalTracingTerm "EnumGender" ;
        sh:path :gender ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:Gender ;
            ]
        ] ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 5 ;
        sh:name "Geburtsdatum"@de,
            "Date of birth"@en,
            "Date de naissance"@fr,
            "Data di nascita"@it ;
        :animalTracingTerm "CattleDetailV1Response.dateOfBirth" ;
        sh:path :dateOfBirth ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 6 ;
        sh:name "Todesdatum"@de,
            "Date of death"@en,
            "Date de mort"@fr,
            "Data di morte"@it ;
        :animalTracingTerm "CattleDetailV1Response.dateOfDeath" ;
        sh:path :dateOfDeath ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 7 ;
        sh:name "Kastriert"@de,
            "Castrated"@en,
            "Castré"@fr,
            "Castrato"@it ;
        :animalTracingTerm "CattleDetailV1Response.isCastrated", "EquidDetailsV1EquidResponse.isCastrated" ;
        sh:description "Gibt an, ob das Tier kastriert ist. Nur für Rinder und Equiden."@de,
            "Whether the animal is castrated. Only for cattle and equids."@en,
            "Indique si l'animal est castré. Uniquement pour les bovins et les équidés."@fr,
            "Indica se l'animale è castrato. Solo per bovini ed equidi."@it ;
        sh:path :castrated ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:order 1 ;
        sh:name "Identifikation Mutter"@de,
            "Mother"@en,
            "Mère"@fr,
            "Madre"@it ;
        :animalTracingTerm "CattleDetailV1ParentageResponse.motherEartagNumber", "EquidDetailsParentageResponse.motherUeln" ;
        sh:path :mother ;
        sh:class :Animal ;
        sh:maxCount 1 ;
        sh:message "Ein Einzeltier hat höchstens ein Muttertier."@de,
            "An individual animal has at most one mother animal."@en,
            "Un animal individuel a au plus une mère."@fr,
            "Un animale singolo ha al massimo una madre."@it ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:description "Jedes Einzeltier ist entweder ein Wiederkäuer oder ein Equide."@de,
            "Every individual animal is either a ruminant or an equid."@en,
            "Chaque animal individuel est soit un ruminant, soit un équidé."@fr,
            "Ogni animale singolo è un ruminante oppure un equide."@it ;
        sh:message "Ein Einzeltier muss ein Wiederkäuer oder ein Equide sein."@de,
            "An individual animal must be a ruminant or an equid."@en,
            "Un animal individuel doit être un ruminant ou un équidé."@fr,
            "Un animale singolo deve essere un ruminante o un equide."@it ;
        sh:prefixes : ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this a :Ruminant . }
                FILTER NOT EXISTS { $this a :Equid . }
            }
        """ ;
    ],
    [
        a sh:SPARQLConstraint ;
        sh:description "Kastriert wird nur für Rinder und Equiden geführt, nicht für Schafe und Ziegen."@de,
            "Castrated is recorded only for cattle and equids, not for sheep and goats."@en,
            "Castré n'est enregistré que pour les bovins et les équidés, pas pour les ovins et les caprins."@fr,
            "Castrato è registrato solo per bovini ed equidi, non per ovini e caprini."@it ;
        sh:message "Für Schafe und Ziegen wird nicht angegeben, ob sie kastriert sind."@de,
            "Whether sheep and goats are castrated is not recorded."@en,
            "Pour les ovins et les caprins, il n'est pas indiqué s'ils sont castrés."@fr,
            "Per ovini e caprini non si indica se sono castrati."@it ;
        sh:prefixes : ;
        sh:select """
            SELECT $this
            WHERE {
                $this :castrated ?castrated ;
                    :genus ?genus .
                FILTER (?genus IN (genus:Sheep, genus:Goat))
            }
        """ ;
    ] .

:RuminantShape a sh:NodeShape ;
    rdfs:label "Wiederkäuer"@de,
        "Ruminant"@en,
        "Ruminant"@fr,
        "Ruminante"@it ;
    rdfs:comment "Subklasse der Klasse Einzeltier für Tiere der Nutztierarten Rinder, Schafe und Ziegen. Alle Attribute der Klasse Einzeltier gelten auch für Wiederkäuer; diese Klasse beschreibt die zusätzlichen Angaben, die für Equiden nicht geführt werden."@de,
        "Subclass of the class individual animal for animals of the genera cattle, sheep and goats. All attributes of the class individual animal also apply to ruminants; this class describes the additional information that is not recorded for equids."@en,
        "Sous-classe de la classe animal individuel pour les animaux des espèces bovins, ovins et caprins. Tous les attributs de la classe animal individuel s'appliquent également aux ruminants ; cette classe décrit les informations supplémentaires qui ne sont pas enregistrées pour les équidés."@fr,
        "Sottoclasse della classe animale singolo per gli animali delle specie bovini, ovini e caprini. Tutti gli attributi della classe animale singolo si applicano anche ai ruminanti; questa classe descrive le informazioni supplementari che non sono registrate per gli equidi."@it ;
    :animalTracingTerm "CattleDetailV1Response", "SheepDetailV1Response", "GoatDetailV1Response" ;
    sh:order 5 ;
    sh:targetClass :Ruminant ;
    sh:property
    [
        sh:order 2 ;
        sh:name "Nutztierart"@de,
            "Genus"@en,
            "Espèce d'animal de rente"@fr,
            "Specie di animale da reddito"@it ;
        :animalTracingTerm "EnumGenus" ;
        sh:path :genus ;
        sh:in ( genus:Cattle genus:Sheep genus:Goat ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 3 ;
        sh:name "TiergeschichteStatus"@de,
            "Animal history state"@en,
            "Statut de l'historique de l'animal"@fr,
            "Stato della storia dell'animale"@it ;
        :animalTracingTerm "EnumAnimalHistoryState" ;
        sh:description "Status der Tiergeschichte zum Abfragedatum."@de,
            "State of the animal history at the date of the query."@en,
            "Statut de l'historique de l'animal à la date de la requête."@fr,
            "Stato della storia dell'animale alla data della richiesta."@it ;
        sh:path :historyState ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:AnimalHistoryState ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 4 ;
        sh:name "Zweck"@de,
            "Type of use"@en,
            "Type d'utilisation"@fr,
            "Tipo di utilizzo"@it ;
        :animalTracingTerm "EnumAnimalTypeOfUse" ;
        sh:path :typeOfUse ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:AnimalTypeOfUse ;
            ]
        ] ;
        sh:maxCount 1 ;
    ] ;
    sh:property
    [
        sh:order 1 ;
        sh:name "Identifikation Vater"@de,
            "Father"@en,
            "Père"@fr,
            "Padre"@it ;
        :animalTracingTerm "CattleDetailV1ParentageResponse.fatherEartagNumber" ;
        sh:path :father ;
        sh:class :Ruminant ;
        sh:maxCount 1 ;
        sh:message "Ein Wiederkäuer hat höchstens ein Vatertier."@de,
            "A ruminant has at most one father animal."@en,
            "Un ruminant a au plus un père."@fr,
            "Un ruminante ha al massimo un padre."@it ;
    ] .


:EquidShape a sh:NodeShape ;
    rdfs:label "Equide"@de,
        "Equid"@en,
        "Équidé"@fr,
        "Equide"@it ;
    rdfs:comment "Subklasse der Klasse Einzeltier für Tiere der Gattung Equiden (Pferd, Maultier, Maulesel, Esel). Alle Attribute der Klasse Einzeltier gelten auch für Equiden; diese Klasse beschreibt ausschliesslich die zusätzlichen, equidenspezifischen Angaben. Die Verantwortung für das Meldewesen liegt bei Equiden nicht beim Tierhaltenden, sondern bei der Eigentümerin oder beim Eigentümer. Ein Eigentümer ist die rechtliche Einheit, in deren Eigentum Equiden sind; der Begriff wird nur für Equideneigentümer geführt."@de,
        "Subclass of the class individual animal for animals of the equid genus (horse, mule, hinny, donkey). All attributes of the class individual animal also apply to equids; this class describes only the additional, equid-specific information. For equids, responsibility for reporting lies with the owner rather than with the animal keeper. An owner is the legal unit that owns equids; the term is used for equid owners only."@en,
        "Sous-classe de la classe animal individuel pour les animaux du genre équidé (cheval, mulet, bardot, âne). Tous les attributs de la classe animal individuel s'appliquent également aux équidés ; cette classe ne décrit que les informations supplémentaires propres aux équidés. Pour les équidés, la responsabilité des notifications incombe au propriétaire et non au détenteur d'animaux. Un propriétaire est l'unité juridique qui détient des équidés en propriété ; le terme n'est utilisé que pour les propriétaires d'équidés."@fr,
        "Sottoclasse della classe animale singolo per gli animali del genere equide (cavallo, mulo, bardotto, asino). Tutti gli attributi della classe animale singolo si applicano anche agli equidi; questa classe descrive esclusivamente le informazioni aggiuntive specifiche degli equidi. Per gli equidi la responsabilità delle notifiche spetta al proprietario e non al detentore di animali. Un proprietario è l'unità giuridica che ha in proprietà degli equidi; il termine è usato solo per i proprietari di equidi."@it ;
    :animalTracingTerm "EquidDetailsEquidResponse", "EquidDetailsPublicEquidResponse" ;
    sh:order 6 ;
    sh:targetClass :Equid ;
    sh:property
    [
        sh:order 5 ;
        sh:name "Meldestatus"@de,
            "Notification state"@en,
            "Statut d'annonce"@fr,
            "Stato di notifica"@it ;
        :animalTracingTerm "EnumEquidNotificationState" ;
        sh:description "Equiden führen anstelle des TiergeschichteStatus einen eigenen Meldestatus."@de,
            "Equids carry a notification state of their own instead of the animal history state."@en,
            "Les équidés portent un statut d'annonce propre au lieu du statut de l'historique de l'animal."@fr,
            "Gli equidi hanno uno stato di notifica proprio invece dello stato della storia dell'animale."@it ;
        sh:path :notificationState ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:EquidNotificationState ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 6 ;
        sh:name "Zweck"@de,
            "Type of use"@en,
            "Type d'utilisation"@fr,
            "Tipo di utilizzo"@it ;
        :animalTracingTerm "EquidTypeOfUsage" ;
        sh:description "Equiden verwenden einen eigenen Wertebereich: Heimtier oder Nutztier."@de,
            "Equids use a code list of their own: companion animal or farm animal."@en,
            "Les équidés utilisent un domaine de valeurs propre: animal de compagnie ou animal de rente."@fr,
            "Gli equidi utilizzano un dominio di valori proprio: animale da compagnia o animale da reddito."@it ;
        sh:path :typeOfEquidUsage ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:EquidTypeOfUsage ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 3 ;
        sh:name "Nutztierart"@de,
            "Genus"@en,
            "Espèce d'animal de rente"@fr,
            "Specie di animale da reddito"@it ;
        :animalTracingTerm "EnumGenus" ;
        sh:path :genus ;
        sh:in ( genus:Equid ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property
    [
        sh:order 4 ;
        sh:name "Grössenkategorie"@de,
            "Withers class"@en,
            "Catégorie de taille"@fr,
            "Categoria di grandezza"@it ;
        :animalTracingTerm "EnumEquidWithersClass" ;
        sh:path :withersClass ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:EquidWithersClass ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:order 1 ;
        sh:name "Eigentümer oder Eigentümerin"@de,
            "Owner"@en,
            "Propriétaire"@fr,
            "Proprietario o proprietaria"@it ;
        :animalTracingTerm "EquidDetailsOwnerResponse.uid", "EquidOwnershipListV1LegalUnitResponse.uid" ;
        :echTerm "eCH-0108:uidType" ;
        sh:description "Die rechtliche Einheit, in deren Eigentum der Equide steht. Bei Equiden liegt die Verantwortung für das Meldewesen beim Eigentümer und nicht beim Tierhaltenden."@de,
            "The legal unit that owns the equid. For equids, responsibility for reporting lies with the owner rather than with the animal keeper."@en,
            "L'unité juridique qui détient l'équidé en propriété. Pour les équidés, la responsabilité des notifications incombe au propriétaire et non au détenteur d'animaux."@fr,
            "L'unità giuridica che ha in proprietà l'equide. Per gli equidi la responsabilità delle notifiche spetta al proprietario e non al detentore di animali."@it ;
        sh:path :owner ;
        sh:class :LegalUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ein Equide hat genau einen Eigentümer oder eine Eigentümerin."@de,
            "An equid has exactly one owner."@en,
            "Un équidé a exactement un propriétaire."@fr,
            "Un equide ha esattamente un proprietario."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Identifikation genetische Mutter"@de,
            "Genetic mother"@en,
            "Mère génétique"@fr,
            "Madre genetica"@it ;
        :animalTracingTerm "EquidDetailsParentageResponse.geneticMotherUeln" ;
        sh:path :geneticMother ;
        sh:class :Equid ;
        sh:maxCount 1 ;
        sh:message "Ein Equide hat höchstens eine genetische Mutter."@de,
            "An equid has at most one genetic mother."@en,
            "Un équidé a au plus une mère génétique."@fr,
            "Un equide ha al massimo una madre genetica."@it ;
    ] .

:AnimalNotificationShape a sh:NodeShape ;
    rdfs:label "Meldung Einzeltier"@de,
        "Individual animal notification"@en,
        "Notification d'animal individuel"@fr,
        "Notifica di animale singolo"@it ;
    rdfs:comment "Ein Ereignis, das ein Einzeltier betrifft. Als Ereignisse gelten Bewegungsmeldungen, Meldungen von Grunddaten, Änderungen einzelner Attribute der Grunddaten sowie finale Meldungen. Eine Meldung bezieht sich immer auf die örtliche Einheit, auf welcher das Ereignis stattgefunden hat, und kann zusätzlich die örtliche Einheit der Herkunft angeben. Die Ereignisse werden durch die berechtigten Personen gemeldet mit Angabe der Tierhaltung, auf die sich die Meldung bezieht; bei Equiden werden sie durch die berechtigten Personen des verantwortlichen Equideneigentümers gemeldet."@de,
        "An event concerning an individual animal. Events comprise movement notifications, notifications of basic data, changes to individual attributes of the basic data as well as final notifications. A notification always refers to the local unit at which the event took place and may in addition state the local unit of origin. Events are reported by the authorised persons, stating the animal holding to which the notification refers; for equids they are reported by the authorised persons of the responsible equid owner."@en,
        "Un événement concernant un animal individuel. Sont considérées comme événements les notifications de mouvement, les notifications de données de base, les modifications d'attributs individuels des données de base ainsi que les notifications finales. Une notification se rapporte toujours à l'unité locale où l'événement a eu lieu et peut en outre indiquer l'unité locale de provenance. Les événements sont annoncés par les personnes autorisées, avec indication de l'unité d'élevage à laquelle la notification se rapporte ; pour les équidés, ils sont annoncés par les personnes autorisées du propriétaire d'équidés responsable."@fr,
        "Un evento che riguarda un animale singolo. Sono considerati eventi le notifiche di movimento, le notifiche di dati di base, le modifiche di singoli attributi dei dati di base nonché le notifiche finali. Una notifica si riferisce sempre all'unità locale in cui si è verificato l'evento e può inoltre indicare l'unità locale di provenienza. Gli eventi sono notificati dalle persone autorizzate, con indicazione della detenzione di animali cui si riferisce la notifica; per gli equidi sono notificati dalle persone autorizzate del proprietario di equidi responsabile."@it ;
    :animalTracingTerm "CattleDetailV1NotificationResponse", "SheepDetailV1NotificationResponse", "GoatDetailV1NotificationResponse" ;
    sh:order 7 ;
    sh:targetClass :AnimalNotification ;
    sh:property
    [
        sh:order 4 ;
        sh:name "ID"@de,
            "ID"@en,
            "ID"@fr,
            "ID"@it ;
        sh:description "Eindeutiger Identifikator der Bewegung, der durch das System vergeben wird."@de,
            "Unique identifier of the movement, assigned by the system."@en,
            "Identifiant univoque du mouvement, attribué par le système."@fr,
            "Identificatore univoco del movimento, attribuito dal sistema."@it ;
        sh:path :id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 5 ;
        sh:name "Nutztierart"@de,
            "Genus"@en,
            "Espèce d'animal de rente"@fr,
            "Specie di animale da reddito"@it ;
        :animalTracingTerm "EnumGenus" ;
        sh:path :genus ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:Genus ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 6 ;
        sh:name "Meldungstyp"@de,
            "Notification type"@en,
            "Type de mouvement"@fr,
            "Tipo di movimento"@it ;
        sh:path :notificationType ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:NotificationType ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 7 ;
        sh:name "Ereignisdatum"@de,
            "Event date"@en,
            "Date de l'événement"@fr,
            "Data dell'evento"@it ;
        sh:description "Datum, an dem das Ereignis stattgefunden hat"@de,
            "Date on which the event took place"@en,
            "Date à laquelle l'événement a eu lieu"@fr,
            "Data in cui si è verificato l'evento"@it ;
        sh:path :eventDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 8 ;
        sh:name "Meldedatum"@de,
            "Notification date"@en,
            "Date d'annonce"@fr,
            "Data di notifica"@it ;
        sh:description "Datum, an dem das Ereignis gemeldet wurde"@de,
            "Date on which the event was reported"@en,
            "Date à laquelle l'événement a été annoncé"@fr,
            "Data in cui l'evento è stato notificato"@it ;
        sh:path :notificationDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:order 1 ;
        sh:name "Identifikator"@de,
            "Identifier"@en,
            "Identifiant"@fr,
            "Identificatore"@it ;
        :animalTracingTerm "CattleDetailV1Response.eartagNumber" ;
        sh:path :animal ;
        sh:class :Animal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine Meldung Einzeltier bezieht sich auf genau ein Einzeltier."@de,
            "An individual animal notification refers to exactly one individual animal."@en,
            "Une notification d'animal individuel se rapporte à exactement un animal individuel."@fr,
            "Una notifica di animale singolo si riferisce a esattamente un animale singolo."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Örtliche Einheit"@de,
            "Local unit"@en,
            "Unité locale"@fr,
            "Unità locale"@it ;
        :animalTracingTerm "CattleDetailV1NotificationResponse.localId" ;
        sh:description "BUR-Nummer der örtlichen Einheit, auf die sich die Meldung bezieht"@de,
            "BUR number of the local unit to which the notification refers"@en,
            "Numéro REE de l'unité locale à laquelle se rapporte la notification"@fr,
            "Numero RIS dell'unità locale a cui si riferisce la notifica"@it ;
        sh:path :localUnit ;
        sh:class :LocalUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine Meldung Einzeltier bezieht sich auf genau eine örtliche Einheit."@de,
            "An individual animal notification refers to exactly one local unit."@en,
            "Une notification d'animal individuel se rapporte à exactement une unité locale."@fr,
            "Una notifica di animale singolo si riferisce a esattamente un'unità locale."@it ;
    ],
    [
        sh:order 3 ;
        sh:name "Herkunft"@de,
            "Origin"@en,
            "Provenance"@fr,
            "Provenienza"@it ;
        :animalTracingTerm "ArrivalNotificationResponse.originLocalId" ;
        sh:description "BUR-Nummer der örtlichen Einheit von der das Tier kommt"@de,
            "BUR number of the local unit the animal comes from"@en,
            "Numéro REE de l'unité locale d'où provient l'animal"@fr,
            "Numero RIS dell'unità locale da cui proviene l'animale"@it ;
        sh:path :originLocalUnit ;
        sh:class :LocalUnit ;
        sh:maxCount 1 ;
        sh:message "Eine Meldung Einzeltier gibt höchstens eine örtliche Einheit als Herkunft an."@de,
            "An individual animal notification states at most one local unit as its origin."@en,
            "Une notification d'animal individuel indique au plus une unité locale comme provenance."@fr,
            "Una notifica di animale singolo indica al massimo un'unità locale come provenienza."@it ;
    ] .

:GroupNotificationShape a sh:NodeShape ;
    rdfs:label "Gruppenmeldung"@de,
        "Group notification"@en,
        "Notification de groupe"@fr,
        "Notifica di gruppo"@it ;
    rdfs:comment "Ein Ereignis für eine nicht eindeutig identifizierbare Tiergruppe. Gruppenmeldungen werden für Tiere der Kategorien Schweine und Geflügel erfasst; die Individuen einer Tiergruppe sind deshalb nicht bekannt. Die Ereignisse werden durch die natürlichen Personen der verantwortlichen rechtlichen Einheit Tierhaltender gemeldet. Sie umfassen Einstallungsmeldungen bei Geflügel, Bewegungsmeldungen bei Schweinen sowie Schlachtungsmeldungen von Schweinen (in Stück) und Geflügelgruppen (in kg)."@de,
        "An event concerning a group of animals that cannot be identified individually. Group notifications are recorded for animals of the categories pigs and poultry; the individuals of such a group are therefore not known. Events are reported by the natural persons of the responsible legal unit, the animal keeper. They comprise housing notifications for poultry, movement notifications for pigs, and slaughter notifications for pigs (by head) and poultry groups (in kg)."@en,
        "Un événement concernant un groupe d'animaux qui ne peuvent pas être identifiés individuellement. Les notifications de groupe sont enregistrées pour les animaux des catégories porcs et volaille ; les individus d'un tel groupe ne sont donc pas connus. Les événements sont annoncés par les personnes physiques de l'unité juridique responsable, le détenteur d'animaux. Ils comprennent les annonces de mise en place pour la volaille, les annonces de mouvement pour les porcs ainsi que les annonces d'abattage de porcs (en têtes) et de groupes de volaille (en kg)."@fr,
        "Un evento che riguarda un gruppo di animali non identificabili singolarmente. Le notifiche di gruppo sono registrate per gli animali delle categorie suini e pollame; gli individui di un tale gruppo non sono pertanto noti. Gli eventi sono notificati dalle persone fisiche dell'unità giuridica responsabile, il detentore di animali. Comprendono le notifiche di accasamento per il pollame, le notifiche di movimento per i suini nonché le notifiche di macellazione di suini (in capi) e di gruppi di pollame (in kg)."@it ;
    sh:order 8 ;
    sh:targetClass :GroupNotification ;
    sh:property
    [
        sh:order 3 ;
        sh:name "ID"@de,
            "ID"@en,
            "ID"@fr,
            "ID"@it ;
        sh:description "Eindeutiger Identifikator der Bewegung, der durch das System vergeben wird."@de,
            "Unique identifier of the movement, assigned by the system."@en,
            "Identifiant univoque du mouvement, attribué par le système."@fr,
            "Identificatore univoco del movimento, attribuito dal sistema."@it ;
        sh:path :id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 4 ;
        sh:name "Nutztierart"@de,
            "Genus"@en,
            "Espèce d'animal de rente"@fr,
            "Specie di animale da reddito"@it ;
        :animalTracingTerm "EnumGenus" ;
        sh:path :genus ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:Genus ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 5 ;
        sh:name "Gruppeninformation"@de,
            "Group information"@en,
            "Information de groupe"@fr,
            "Informazione di gruppo"@it ;
        sh:description "Nur für Geflügel, nicht für Schweine: Bei Einstallungsmeldungen ist eine Gruppeninformation anzugeben."@de,
            "Only for poultry, not for pigs: group information must be given for housing notifications."@en,
            "Uniquement pour la volaille, pas pour les porcs : une information de groupe doit être indiquée pour les annonces de mise en place."@fr,
            "Solo per il pollame, non per i suini: per le notifiche di accasamento va indicata un'informazione di gruppo."@it ;
        sh:path :groupInformation ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 6 ;
        sh:name "Meldungstyp"@de,
            "Notification type"@en,
            "Type de mouvement"@fr,
            "Tipo di movimento"@it ;
        sh:path :notificationType ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:NotificationType ;
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 7 ;
        sh:name "Ereignisdatum"@de,
            "Event date"@en,
            "Date de l'événement"@fr,
            "Data dell'evento"@it ;
        sh:description "Datum, an dem das Ereignis stattgefunden hat"@de,
            "Date on which the event took place"@en,
            "Date à laquelle l'événement a eu lieu"@fr,
            "Data in cui si è verificato l'evento"@it ;
        sh:path :eventDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 8 ;
        sh:name "Meldedatum"@de,
            "Notification date"@en,
            "Date d'annonce"@fr,
            "Data di notifica"@it ;
        sh:description "Datum, an dem das Ereignis gemeldet wurde"@de,
            "Date on which the event was reported"@en,
            "Date à laquelle l'événement a été annoncé"@fr,
            "Data in cui l'evento è stato notificato"@it ;
        sh:path :notificationDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 9 ;
        sh:name "Anzahl"@de,
            "Number"@en,
            "Nombre"@fr,
            "Numero"@it ;
        sh:description "Anzahl Tiere, die in einer Bewegung verstellt wurden (Schweine/Geflügel)"@de,
            "Number of animals moved in one movement (pigs/poultry)"@en,
            "Nombre d'animaux déplacés lors d'un mouvement (porcs/volaille)"@fr,
            "Numero di animali spostati in un movimento (suini/pollame)"@it ;
        sh:path :count ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 10 ;
        sh:name "Gewicht"@de,
            "Weight"@en,
            "Poids"@fr,
            "Peso"@it ;
        sh:description "Nur für Geflügel: Gesamtgewicht der Tiergruppe in kg bei Schlachtungsmeldungen. Schlachtungen von Schweinen werden in Stück gemeldet (Anzahl)."@de,
            "Only for poultry: total weight of the animal group in kg for slaughter notifications. Slaughterings of pigs are notified in head (count)."@en,
            "Uniquement pour la volaille : poids total du groupe d'animaux en kg pour les annonces d'abattage. Les abattages de porcs sont annoncés en nombre de têtes (nombre)."@fr,
            "Solo per il pollame: peso totale del gruppo di animali in kg per le notifiche di macellazione. Le macellazioni di suini sono notificate in capi (numero)."@it ;
        sh:path :weight ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 11 ;
        sh:name "Zweck"@de,
            "Type of use"@en,
            "Type d'utilisation"@fr,
            "Tipo di utilizzo"@it ;
        sh:description "Nutzungsart der Tiergruppe (bei Einzeltieren wird die Nutzungsart auf der Klasse «Einzeltier» geführt)"@de,
            "Type of use of the animal group (for individual animals it is held on the class «Einzeltier»)"@en,
            "Type d'utilisation du groupe d'animaux (pour les animaux individuels il figure sur la classe «Einzeltier»)"@fr,
            "Tipo di utilizzo del gruppo di animali (per gli animali singoli figura sulla classe «Einzeltier»)"@it ;
        sh:path :typeOfUse ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:AnimalTypeOfUse ;
            ]
        ] ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 12 ;
        sh:name "Alter"@de,
            "Age"@en,
            "Âge"@fr,
            "Età"@it ;
        sh:description "Nur für Geflügel, nicht für Schweine: Bei Einstallungsmeldungen ist das Alter in Wochen anzugeben."@de,
            "Only for poultry, not for pigs: the age must be given in weeks for housing notifications."@en,
            "Uniquement pour la volaille, pas pour les porcs : l'âge doit être indiqué en semaines pour les annonces de mise en place."@fr,
            "Solo per il pollame, non per i suini: per le notifiche di accasamento l'età va indicata in settimane."@it ;
        sh:path :age ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:order 1 ;
        sh:name "Örtliche Einheit"@de,
            "Local unit"@en,
            "Unité locale"@fr,
            "Unità locale"@it ;
        sh:description "BUR-Nummer der örtlichen Einheit"@de,
            "BUR number of the local unit"@en,
            "Numéro REE de l'unité locale"@fr,
            "Numero RIS dell'unità locale"@it ;
        sh:path :localUnit ;
        sh:class :LocalUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine Gruppenmeldung bezieht sich auf genau eine örtliche Einheit."@de,
            "A group notification refers to exactly one local unit."@en,
            "Une notification de groupe se rapporte à exactement une unité locale."@fr,
            "Una notifica di gruppo si riferisce a esattamente un'unità locale."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Herkunft"@de,
            "Origin"@en,
            "Provenance"@fr,
            "Provenienza"@it ;
        sh:description "BUR-Nummer der örtlichen Einheit von der das Tier kommt"@de,
            "BUR number of the local unit the animal comes from"@en,
            "Numéro REE de l'unité locale d'où provient l'animal"@fr,
            "Numero RIS dell'unità locale da cui proviene l'animale"@it ;
        sh:path :originLocalUnit ;
        sh:class :LocalUnit ;
        sh:maxCount 1 ;
        sh:message "Eine Gruppenmeldung gibt höchstens eine örtliche Einheit als Herkunft an."@de,
            "A group notification states at most one local unit as its origin."@en,
            "Une notification de groupe indique au plus une unité locale comme provenance."@fr,
            "Una notifica di gruppo indica al massimo un'unità locale come provenienza."@it ;
    ] .

:AnimalHealthStatusShape a sh:NodeShape ;
    rdfs:label "Gesundheitsstatus Einzeltier"@de,
        "Health status of an individual animal"@en,
        "État sanitaire de l'animal individuel"@fr,
        "Stato sanitario dell'animale singolo"@it ;
    rdfs:comment "Eine Seucheninformation, die auf einem Einzeltier erfasst ist. Zusätzlich zum individuellen Seuchenstatus werden damit auch relevante Impfungen erfasst."@de,
        "Disease information recorded for an individual animal. In addition to the individual epizootic status, relevant vaccinations are recorded as well."@en,
        "Une information épizootique enregistrée sur un animal individuel. Outre le statut épizootique individuel, les vaccinations pertinentes sont également enregistrées."@fr,
        "Un'informazione epizootica registrata su un animale singolo. Oltre allo stato epizootico individuale, vengono registrate anche le vaccinazioni rilevanti."@it ;
    :animalTracingTerm "CattleDetailV1DiseasesResponse" ;
    sh:order 9 ;
    sh:targetClass :AnimalHealthStatus ;
    sh:property
    [
        sh:order 2 ;
        sh:name "Typ"@de,
            "Type"@en,
            "Type"@fr,
            "Tipo"@it ;
        sh:description "z. B. Seuchenstatus, Impfstatus, Risikostatus"@de,
            "e.g. epizootic, vaccination or risk status"@en,
            "p. ex. statut épizootique, vaccinal ou de risque"@fr,
            "p. es. stato epizootico, vaccinale o di rischio"@it ;
        sh:path :healthStatusType ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:HealthStatusType ;
            ]
        ] ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 4 ;
        sh:name "Status"@de,
            "Status"@en,
            "Statut"@fr,
            "Stato"@it ;
        sh:path :epizooticStatus ;
        sh:class schema:CategoryCode ;
        sh:node [
            sh:property [
                sh:path schema:inCodeSet ;
                sh:hasValue codelist:AnimalEpizooticStatus ;
            ]
        ] ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 5 ;
        sh:name "Datum"@de,
            "Date"@en,
            "Date"@fr,
            "Data"@it ;
        sh:description "Datum, ab dem der Seuchenstatus gültig ist oder das Impfdatum"@de,
            "Date from which the status is valid, or the date of vaccination"@en,
            "Date à partir de laquelle le statut est valable, ou la date de vaccination"@fr,
            "Data a partire dalla quale lo stato è valido, o la data della vaccinazione"@it ;
        sh:path :validFrom ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:order 1 ;
        sh:name "Tier-ID"@de,
            "Animal ID"@en,
            "ID de l'animal"@fr,
            "ID dell'animale"@it ;
        :animalTracingTerm "CattleDetailV1Response.eartagNumber" ;
        sh:path :animal ;
        sh:class :Animal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ein Gesundheitsstatus Einzeltier bezieht sich auf genau ein Einzeltier."@de,
            "A health status of an individual animal refers to exactly one individual animal."@en,
            "Un état sanitaire de l'animal individuel se rapporte à exactement un animal individuel."@fr,
            "Uno stato sanitario dell'animale singolo si riferisce a esattamente un animale singolo."@it ;
    ] .
