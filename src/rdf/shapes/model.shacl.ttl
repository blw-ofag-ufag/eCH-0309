# ==============================================================================
# SHACL DATA MODEL METADATA
# ==============================================================================

: a owl:Ontology ;
    rdfs:label "eCH-0309-Datenmodell"@de,
        "eCH-0309 data model"@en,
        "modèle de données eCH-0309"@fr,
        "modello di dati eCH-0309"@it ;
    rdfs:comment "Dieses SHACL-Datenmodell beschreibt das Datenmodell aus dem Hilfsmittel eCH-0309 'Tierverkehrsdaten'."@de,
        "This SHACL data model describes the data model from the tool eCH-0309 'Animal Movement Data'."@en,
        "Ce modèle de données SHACL décrit le modèle de données de l'outil eCH-0309 « Données sur le trafic des animaux »."@fr,
        "Questo modello di dati SHACL descrive il modello di dati dello strumento eCH-0309 'Dati sul traffico di animali'."@it ;
    sh:declare [
        sh:prefix "schema" ;
        sh:namespace "http://schema.org/"^^xsd:anyURI ;
    ],
    [
        sh:prefix "" ;
        sh:namespace "https://agriculture.ld.admin.ch/eCH-1234/2/"^^xsd:anyURI ;
    ] .

