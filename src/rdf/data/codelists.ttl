# ==============================================================================
# CODE LISTS (Wertebereiche)
#
# The Wertebereiche are part of the Hilfsmittel, so they are defined here and
# edited here. They follow the template's code list structure: a list is a
# schema:CategoryCodeSet, its values are schema:CategoryCode instances, as
# prescribed by src/rdf/shapes/codelist.shacl.ttl and checked by
# tests/test_codelists.py. The data model restricts a property to a list with
# sh:node [ sh:property [ sh:path schema:inCodeSet ; sh:hasValue <list> ] ].
#
# tests/test_code_lists.py compares the lists against the TVD AnimalTracing
# openAPI (TVD API Gateway Animal Tracing 1.0,
# https://test-01-tvd-api-at.identitas.ch/open-api/v1.0, as of 2026-10-27) and
# reports drift in both directions: a value this file carries that the
# interface has dropped, and a value the interface has gained that nobody has
# decided about. A list derived from an enum is recognised by the property
# shape in model.shacl.ttl that restricts to it and names the enum with
# :animalTracingTerm; the code value of each value is the enum member.
# Known-absent values are listed in the test with their reason.
#
# Each list has its own sub-namespace for its values, and each value is named
# by the identifier its source system uses, as in eCH-0265, where the AGIS,
# NAEBI and PSM lists are keyed by their own numeric codes. The identifier is
# therefore not ours to case.
#
# Four lists -- Bewegungstyp, Typ Gesundheitsstatus and the two Seuchenstatus
# lists -- come from the Wertebereich tables of the Hilfsmittel alone: the
# openAPI splits notification types per species and holds the health statuses as
# a field per disease.
#
# French and Italian labels and most descriptions are still missing where the
# sources provide none.
# ==============================================================================

@prefix codelist:               <https://agriculture.ld.admin.ch/eCH-0309/1/codelist/> .
@prefix genus:                  <https://agriculture.ld.admin.ch/eCH-0309/1/genus/> .
@prefix gender:                 <https://agriculture.ld.admin.ch/eCH-0309/1/gender/> .
@prefix animaltypeofuse:        <https://agriculture.ld.admin.ch/eCH-0309/1/animaltypeofuse/> .
@prefix equidtypeofusage:       <https://agriculture.ld.admin.ch/eCH-0309/1/equidtypeofusage/> .
@prefix animalhistorystate:     <https://agriculture.ld.admin.ch/eCH-0309/1/animalhistorystate/> .
@prefix equidnotificationstate: <https://agriculture.ld.admin.ch/eCH-0309/1/equidnotificationstate/> .
@prefix equidwithersclass:      <https://agriculture.ld.admin.ch/eCH-0309/1/equidwithersclass/> .
@prefix notificationtype:       <https://agriculture.ld.admin.ch/eCH-0309/1/notificationtype/> .
@prefix healthstatustype:       <https://agriculture.ld.admin.ch/eCH-0309/1/healthstatustype/> .
@prefix localunithealthstatus:  <https://agriculture.ld.admin.ch/eCH-0309/1/localunithealthstatus/> .
@prefix animalhealthstatus:     <https://agriculture.ld.admin.ch/eCH-0309/1/animalhealthstatus/> .

@prefix schema:                 <http://schema.org/> .


# ------------------------------------------------------------------------------
# Nutztierart -- openAPI EnumGenus
# Hilfsmittel: Tabelle 2: Definition Wertebereich Nutztierarten für die TVD
# ------------------------------------------------------------------------------

codelist:Genus a schema:CategoryCodeSet ;
    schema:name "Nutztierart"@de,
        "Genus"@en,
        "Espèce d'animal de rente"@fr,
        "Specie di animale da reddito"@it ;
    schema:hasCategoryCode genus:Cattle,
        genus:Pig,
        genus:Sheep,
        genus:Goat,
        genus:Camelid,
        genus:Game,
        genus:Equid,
        genus:Poultry .

genus:Cattle a schema:CategoryCode ;
    schema:inCodeSet codelist:Genus ;
    schema:codeValue "Cattle" ;
    schema:name "Rindvieh"@de,
        "Cattle"@en ;
    schema:description "Tiere der Rindergattung (*Bos*) und Wasserbüffel (*Bubalus bubalis*)"@de .

genus:Pig a schema:CategoryCode ;
    schema:inCodeSet codelist:Genus ;
    schema:codeValue "Pig" ;
    schema:name "Schweine"@de,
        "Pig"@en .

genus:Sheep a schema:CategoryCode ;
    schema:inCodeSet codelist:Genus ;
    schema:codeValue "Sheep" ;
    schema:name "Schafe"@de,
        "Sheep"@en .

genus:Goat a schema:CategoryCode ;
    schema:inCodeSet codelist:Genus ;
    schema:codeValue "Goat" ;
    schema:name "Ziegen"@de,
        "Goat"@en .

genus:Camelid a schema:CategoryCode ;
    schema:inCodeSet codelist:Genus ;
    schema:codeValue "Camelid" ;
    schema:name "Kameliden"@de,
        "Camelid"@en ;
    schema:description "Neuweltkameliden"@de .

genus:Game a schema:CategoryCode ;
    schema:inCodeSet codelist:Genus ;
    schema:codeValue "Game" ;
    schema:name "Wild"@de,
        "Game"@en ;
    schema:description "Wild in Gehegen"@de .

genus:Equid a schema:CategoryCode ;
    schema:inCodeSet codelist:Genus ;
    schema:codeValue "Equid" ;
    schema:name "Equiden"@de,
        "Equid"@en ;
    schema:description "Tiere der Pferdegattung (Pferd, Maultier, Maulesel, Esel)"@de .

genus:Poultry a schema:CategoryCode ;
    schema:inCodeSet codelist:Genus ;
    schema:codeValue "Poultry" ;
    schema:name "Geflügel"@de,
        "Poultry"@en .


# ------------------------------------------------------------------------------
# Geschlecht -- openAPI EnumGender
# Hilfsmittel: Tabelle 6: Definition Wertebereich Geschlecht
# ------------------------------------------------------------------------------

codelist:Gender a schema:CategoryCodeSet ;
    schema:name "Geschlecht"@de,
        "Gender"@en,
        "Sexe"@fr,
        "Sesso"@it ;
    schema:hasCategoryCode gender:Female,
        gender:Male .

gender:Female a schema:CategoryCode ;
    schema:inCodeSet codelist:Gender ;
    schema:codeValue "Female" ;
    schema:name "Weiblich"@de,
        "Female"@en .

gender:Male a schema:CategoryCode ;
    schema:inCodeSet codelist:Gender ;
    schema:codeValue "Male" ;
    schema:name "Männlich"@de,
        "Male"@en .


