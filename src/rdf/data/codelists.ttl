# Hilfsmittel: Tabelle 3: Definition Wertebereich Zweck pro Nutztierart
# ------------------------------------------------------------------------------

codelist:AnimalTypeOfUse a schema:CategoryCodeSet ;
    schema:name "Zweck (Rinder, Schafe, Ziegen)"@de,
        "Type of use (cattle, sheep, goats)"@en,
        "Type d'utilisation (bovins, ovins, caprins)"@fr,
        "Tipo di utilizzo (bovini, ovini, caprini)"@it ;
