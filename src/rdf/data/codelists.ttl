codelist:NotificationType a schema:CategoryCodeSet ;
    schema:name "Bewegungstyp"@de,
        "Notification type"@en,
        "Type de mouvement"@fr,
        "Tipo di movimento"@it ;
    schema:description "Art einer Meldung zu einem Einzeltier, z. B. eine Bewegung, eine Geburt oder eine Schlachtung."@de,
        "Type of a notification about an individual animal, e.g. a movement, a birth or a slaughter."@en,
        "Type d'une annonce concernant un animal individuel, p. ex. un mouvement, une naissance ou un abattage."@fr,
        "Tipo di una notifica relativa a un singolo animale, p. es. un movimento, una nascita o una macellazione."@it ;
    schema:hasCategoryCode notificationtype:Birth,
        notificationtype:Arrival,
        notificationtype:Leaving,
        notificationtype:Slaughter,
        notificationtype:Deceased,
        notificationtype:Import,
        notificationtype:Export,
        notificationtype:DayStay,
        notificationtype:ImportAfterExport,
        notificationtype:OnFarmSlaughter,
        notificationtype:DeathBirth,
        notificationtype:LocationChange,
        notificationtype:FirstRegistration .

