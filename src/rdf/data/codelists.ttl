        "Animale maschio"@it .


# ------------------------------------------------------------------------------
# Zweck (Rinder, Schafe, Ziegen) -- openAPI EnumAnimalTypeOfUse
# Hilfsmittel: Tabelle 3: Definition Wertebereich Zweck pro Nutztierart
# ------------------------------------------------------------------------------

codelist:AnimalTypeOfUse a schema:CategoryCodeSet ;
    schema:name "Zweck (Rinder, Schafe, Ziegen)"@de,
        "Type of use (cattle, sheep, goats)"@en,
        "Type d'utilisation (bovins, ovins, caprins)"@fr,
        "Tipo di utilizzo (bovini, ovini, caprini)"@it ;
    schema:description "Nutzungsart von Rindern, Schafen und Ziegen."@de,
        "Type of use of cattle, sheep and goats."@en,
        "Type d'utilisation des bovins, ovins et caprins."@fr,
        "Tipo di utilizzo di bovini, ovini e caprini."@it ;
    schema:hasCategoryCode animaltypeofuse:Other,
        animaltypeofuse:Milk .

animaltypeofuse:Other a schema:CategoryCode ;
    schema:inCodeSet codelist:AnimalTypeOfUse ;
    schema:codeValue "Other" ;
    schema:name "Andere"@de,
        "Other"@en,
        "Autre"@fr,
        "Altro"@it ;
    schema:description "Jede andere Nutzung als die Milchproduktion, z. B. Fleischproduktion"@de,
        "Any use other than milk production, e.g. meat production"@en,
        "Toute utilisation autre que la production laitière, p. ex. la production de viande"@fr,
        "Qualsiasi utilizzo diverso dalla produzione di latte, p. es. la produzione di carne"@it .

animaltypeofuse:Milk a schema:CategoryCode ;
    schema:inCodeSet codelist:AnimalTypeOfUse ;
    schema:codeValue "Milk" ;
    schema:name "Milch"@de,
        "Milk"@en,
        "Lait"@fr,
        "Latte"@it ;
    schema:description "Milchkühe, -schafe und -ziegen"@de,
        "Dairy cows, sheep and goats"@en,
        "Vaches, brebis et chèvres laitières"@fr,
        "Vacche, pecore e capre da latte"@it .


# ------------------------------------------------------------------------------
# Zweck (Equiden) -- openAPI EquidTypeOfUsage
# Hilfsmittel: Tabelle 3: Definition Wertebereich Zweck pro Nutztierart
# ------------------------------------------------------------------------------

codelist:EquidTypeOfUsage a schema:CategoryCodeSet ;
    schema:name "Zweck (Equiden)"@de,
        "Type of use (equids)"@en,
        "Type d'utilisation (équidés)"@fr,
        "Tipo di utilizzo (equidi)"@it ;
    schema:description "Verwendungszweck eines Equiden; er bestimmt, ob der Equide zur Lebensmittelgewinnung geschlachtet werden darf."@de,
        "Type of use of an equid; it determines whether the equid may be slaughtered for food production."@en,
        "Type d'utilisation d'un équidé ; il détermine si l'équidé peut être abattu pour la production de denrées alimentaires."@fr,
        "Tipo di utilizzo di un equide; determina se l'equide può essere macellato per la produzione di derrate alimentari."@it ;
    schema:hasCategoryCode equidtypeofusage:CompanionAnimal,
        equidtypeofusage:FarmAnimal .

equidtypeofusage:CompanionAnimal a schema:CategoryCode ;
    schema:inCodeSet codelist:EquidTypeOfUsage ;
    schema:codeValue "CompanionAnimal" ;
    schema:name "Heimtier"@de,
        "Companion animal"@en,
        "Animal de compagnie"@fr,
        "Animale da compagnia"@it ;
    schema:description "Equide, der nicht zur Lebensmittelgewinnung geschlachtet werden darf"@de,
        "Equid that must not be slaughtered for food production"@en,
        "Équidé qui ne peut pas être abattu pour la production de denrées alimentaires"@fr,
        "Equide che non può essere macellato per la produzione di derrate alimentari"@it .

equidtypeofusage:FarmAnimal a schema:CategoryCode ;
    schema:inCodeSet codelist:EquidTypeOfUsage ;
    schema:codeValue "FarmAnimal" ;
    schema:name "Nutztier"@de,
        "Farm animal"@en,
        "Animal de rente"@fr,
        "Animale da reddito"@it ;
    schema:description "Equide, der zur Lebensmittelgewinnung geschlachtet werden darf"@de,
        "Equid that may be slaughtered for food production"@en,
        "Équidé qui peut être abattu pour la production de denrées alimentaires"@fr,
        "Equide che può essere macellato per la produzione di derrate alimentari"@it .


# ------------------------------------------------------------------------------
# Tiergeschichtestatus -- openAPI EnumAnimalHistoryState
# Hilfsmittel: Tabelle 7: Definition Wertebereich Tiergeschichtestatus
# The value descriptions are drafts; their meaning is open in issue #46.
# ------------------------------------------------------------------------------

codelist:AnimalHistoryState a schema:CategoryCodeSet ;
    schema:name "Tiergeschichtestatus"@de,
        "Animal history state"@en,
        "Statut de l'historique de l'animal"@fr,
        "Stato della storia dell'animale"@it ;
    schema:description "Status der Tiergeschichte eines Einzeltiers zum Abfragedatum. Nicht relevant für Equiden."@de,
        "State of the history of an individual animal on the query date. Not relevant for equids."@en,
        "Statut de l'historique d'un animal individuel à la date de la requête. Non pertinent pour les équidés."@fr,
        "Stato della storia di un singolo animale alla data della richiesta. Non rilevante per gli equidi."@it ;
    schema:hasCategoryCode animalhistorystate:NotDefined,
        animalhistorystate:NotOk,
        animalhistorystate:TemporaryOk,
        animalhistorystate:Ok,
        animalhistorystate:Lost .

animalhistorystate:NotDefined a schema:CategoryCode ;
    schema:inCodeSet codelist:AnimalHistoryState ;
    schema:codeValue "NotDefined" ;
    schema:name "Nicht definiert"@de,
        "Not defined"@en,
        "Non défini"@fr,
        "Non definito"@it ;
    schema:description "Für die Tiergeschichte ist kein Status festgelegt"@de,
        "No status has been set for the animal history"@en,
        "Aucun statut n'est défini pour l'historique de l'animal"@fr,
        "Per la storia dell'animale non è stato definito alcuno stato"@it .

animalhistorystate:NotOk a schema:CategoryCode ;
    schema:inCodeSet codelist:AnimalHistoryState ;
    schema:codeValue "NotOk" ;
    schema:name "Fehlerhaft"@de,
        "Not ok"@en,
        "Erroné"@fr,
        "Errato"@it ;
    schema:description "Die Tiergeschichte enthält Fehler oder Lücken"@de,
        "The animal history contains errors or gaps"@en,
        "L'historique de l'animal contient des erreurs ou des lacunes"@fr,
        "La storia dell'animale contiene errori o lacune"@it .

animalhistorystate:TemporaryOk a schema:CategoryCode ;
    schema:inCodeSet codelist:AnimalHistoryState ;
    schema:codeValue "TemporaryOk" ;
    schema:name "Temporär OK"@de,
        "Temporary ok"@en,
        "Provisoirement OK"@fr,
        "Provvisoriamente OK"@it ;
    schema:description "Die Tiergeschichte gilt vorläufig als korrekt"@de,
        "The animal history is provisionally considered correct"@en,
        "L'historique de l'animal est provisoirement considéré comme correct"@fr,
        "La storia dell'animale è considerata provvisoriamente corretta"@it .

animalhistorystate:Ok a schema:CategoryCode ;
    schema:inCodeSet codelist:AnimalHistoryState ;
    schema:codeValue "Ok" ;
    schema:name "OK"@de,
        "Ok"@en,
        "OK"@fr,
        "OK"@it ;
    schema:description "Die Tiergeschichte ist vollständig und korrekt"@de,
        "The animal history is complete and correct"@en,
        "L'historique de l'animal est complet et correct"@fr,
        "La storia dell'animale è completa e corretta"@it .

animalhistorystate:Lost a schema:CategoryCode ;
    schema:inCodeSet codelist:AnimalHistoryState ;
    schema:codeValue "Lost" ;
    schema:name "Verschollen"@de,
        "Lost"@en,
        "Disparu"@fr,
        "Disperso"@it ;
    schema:description "Der Verbleib des Tiers ist unbekannt"@de,
        "The whereabouts of the animal are unknown"@en,
        "On ignore où se trouve l'animal"@fr,
        "Non si sa dove si trovi l'animale"@it .


# ------------------------------------------------------------------------------
# Grössenkategorie -- openAPI EnumEquidWithersClass
# No Wertebereich table in the Hilfsmittel. Hilfsmittel and openAPI disagree
# on where a height of exactly 148 cm belongs; open in issue #48.
# ------------------------------------------------------------------------------

codelist:EquidWithersClass a schema:CategoryCodeSet ;
    schema:name "Grössenkategorie"@de,
        "Withers class"@en,
        "Catégorie de taille"@fr,
        "Categoria di grandezza"@it ;
    schema:description "Einteilung der Equiden in zwei Kategorien nach ihrer Widerristhöhe."@de,
        "Classification of equids into two categories by their height at the withers."@en,
        "Classification des équidés en deux catégories selon leur hauteur au garrot."@fr,
        "Suddivisione degli equidi in due categorie secondo la loro altezza al garrese."@it ;
    schema:hasCategoryCode equidwithersclass:LessOrEqualThan148cm,
        equidwithersclass:GreaterThan148cm .

equidwithersclass:LessOrEqualThan148cm a schema:CategoryCode ;
    schema:inCodeSet codelist:EquidWithersClass ;
    schema:codeValue "LessOrEqualThan148cm" ;
    schema:name "Widerristhöhe bis 148 cm"@de,
        "Withers height up to 148 cm"@en,
        "Hauteur au garrot jusqu'à 148 cm"@fr,
        "Altezza al garrese fino a 148 cm"@it ;
    schema:description "Equiden mit einer Widerristhöhe von höchstens 148 cm"@de,
        "Equids with a height at the withers of at most 148 cm"@en,
        "Équidés d'une hauteur au garrot de 148 cm au plus"@fr,
        "Equidi con un'altezza al garrese di 148 cm al massimo"@it .

equidwithersclass:GreaterThan148cm a schema:CategoryCode ;
    schema:inCodeSet codelist:EquidWithersClass ;
    schema:codeValue "GreaterThan148cm" ;
    schema:name "Widerristhöhe über 148 cm"@de,
        "Withers height above 148 cm"@en,
        "Hauteur au garrot supérieure à 148 cm"@fr,
        "Altezza al garrese superiore a 148 cm"@it ;
    schema:description "Equiden mit einer Widerristhöhe von mehr als 148 cm"@de,
        "Equids with a height at the withers of more than 148 cm"@en,
        "Équidés d'une hauteur au garrot supérieure à 148 cm"@fr,
        "Equidi con un'altezza al garrese superiore a 148 cm"@it .


