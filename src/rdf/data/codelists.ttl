# ------------------------------------------------------------------------------
# Meldestatus Equide -- openAPI EnumEquidNotificationState
# Keine Wertebereichstabelle im Hilfsmittel; die Werte stammen allein aus der
# openAPI, die Bezeichnungen sind daraus abgeleitet. Bedeutung offen in #47.
# ------------------------------------------------------------------------------

codelist:EquidNotificationState a schema:CategoryCodeSet ;
    schema:name "Meldestatus Equide"@de,
        "Equid notification state"@en,
        "Statut d'annonce de l'équidé"@fr,
        "Stato di notifica dell'equide"@it ;
    schema:description "Stand der Meldungen zu einem Equiden: ob ein Standortwechsel oder eine Eigentumsübernahme noch hängig ist."@de,
        "State of the notifications about an equid: whether a change of location or a transfer of ownership is still pending."@en,
        "État des annonces concernant un équidé : un changement de lieu ou une reprise de propriété est-il encore en attente."@fr,
        "Stato delle notifiche relative a un equide: se un cambiamento di ubicazione o un'acquisizione della proprietà è ancora in sospeso."@it ;
    schema:hasCategoryCode equidnotificationstate:Ok,
        equidnotificationstate:LocationChangePending,
        equidnotificationstate:OwnershipAcquisitionPending,
        equidnotificationstate:LocationChangeAndAcquisitionPending .

equidnotificationstate:Ok a schema:CategoryCode ;
    schema:inCodeSet codelist:EquidNotificationState ;
    schema:codeValue "Ok" ;
    schema:name "OK"@de,
        "OK"@en,
        "OK"@fr,
        "OK"@it ;
    schema:description "Für den Equiden ist keine Meldung hängig"@de,
        "No notification is pending for the equid"@en,
        "Aucune annonce n'est en attente pour l'équidé"@fr,
        "Nessuna notifica è in sospeso per l'equide"@it .

equidnotificationstate:LocationChangePending a schema:CategoryCode ;
    schema:inCodeSet codelist:EquidNotificationState ;
    schema:codeValue "LocationChangePending" ;
    schema:name "Standortwechsel hängig"@de,
        "Change of location pending"@en,
        "Changement de lieu en attente"@fr,
        "Cambiamento di ubicazione in sospeso"@it ;
    schema:description "Die Meldung eines Standortwechsels ist noch nicht abgeschlossen"@de,
        "A notification of a change of location has not yet been completed"@en,
        "L'annonce d'un changement de lieu n'est pas encore terminée"@fr,
        "La notifica di un cambiamento di ubicazione non è ancora conclusa"@it .

equidnotificationstate:OwnershipAcquisitionPending a schema:CategoryCode ;
    schema:inCodeSet codelist:EquidNotificationState ;
    schema:codeValue "OwnershipAcquisitionPending" ;
    schema:name "Eigentumsübernahme hängig"@de,
        "Transfer of ownership pending"@en,
        "Reprise de propriété en attente"@fr,
        "Acquisizione della proprietà in sospeso"@it ;
    schema:description "Die Meldung einer Eigentumsübernahme ist noch nicht abgeschlossen"@de,
        "A notification of a transfer of ownership has not yet been completed"@en,
        "L'annonce d'une reprise de propriété n'est pas encore terminée"@fr,
        "La notifica di un'acquisizione della proprietà non è ancora conclusa"@it .

equidnotificationstate:LocationChangeAndAcquisitionPending a schema:CategoryCode ;
    schema:inCodeSet codelist:EquidNotificationState ;
    schema:codeValue "LocationChangeAndAcquisitionPending" ;
    schema:name "Standortwechsel und Eigentumsübernahme hängig"@de,
        "Change of location and transfer of ownership pending"@en,
        "Changement de lieu et reprise de propriété en attente"@fr,
        "Cambiamento di ubicazione e acquisizione della proprietà in sospeso"@it ;
    schema:description "Die Meldungen eines Standortwechsels und einer Eigentumsübernahme sind noch nicht abgeschlossen"@de,
        "Notifications of a change of location and of a transfer of ownership have not yet been completed"@en,
        "Les annonces d'un changement de lieu et d'une reprise de propriété ne sont pas encore terminées"@fr,
        "Le notifiche di un cambiamento di ubicazione e di un'acquisizione della proprietà non sono ancora concluse"@it .
