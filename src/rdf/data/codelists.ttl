codelist:HealthStatusType a schema:CategoryCodeSet ;
    schema:name "Typ Gesundheitsstatus"@de,
        "Health status type"@en,
        "Type d'état sanitaire"@fr,
        "Tipo di stato sanitario"@it ;
    schema:description "Art eines Gesundheitsstatus einer örtlichen Einheit oder eines Einzeltiers."@de,
        "Kind of health status of a local unit or an individual animal."@en,
        "Type d'un état sanitaire d'une unité locale ou d'un animal individuel."@fr,
        "Tipo di uno stato sanitario di un'unità locale o di un singolo animale."@it ;
    schema:hasCategoryCode healthstatustype:EpizooticStatus,
        healthstatustype:VaccinationStatus,
        healthstatustype:RiskStatus,
        healthstatustype:LaboratoryResult .

healthstatustype:EpizooticStatus a schema:CategoryCode ;
    schema:inCodeSet codelist:HealthStatusType ;
    schema:codeValue "EpizooticStatus" ;
    schema:name "Seuchenstatus"@de,
        "Epizootic status"@en,
        "Statut épizootique"@fr,
        "Stato epizootico"@it ;
    schema:description "Status bezüglich einer Tierseuche, z. B. gesperrt oder frei"@de,
        "Status regarding an animal disease, e.g. blocked or free"@en,
        "Statut relatif à une épizootie, p. ex. bloqué ou libre"@fr,
        "Stato relativo a un'epizoozia, p. es. bloccato o libero"@it .

healthstatustype:VaccinationStatus a schema:CategoryCode ;
    schema:inCodeSet codelist:HealthStatusType ;
    schema:codeValue "VaccinationStatus" ;
    schema:name "Impfstatus"@de,
        "Vaccination status"@en,
        "Statut vaccinal"@fr,
        "Stato vaccinale"@it ;
    schema:description "Angabe, ob gegen eine Tierseuche geimpft wurde"@de,
        "Whether vaccination against an animal disease has taken place"@en,
        "Indique si une vaccination contre une épizootie a été effectuée"@fr,
        "Indica se è stata eseguita una vaccinazione contro un'epizoozia"@it .

healthstatustype:RiskStatus a schema:CategoryCode ;
    schema:inCodeSet codelist:HealthStatusType ;
    schema:codeValue "RiskStatus" ;
    schema:name "Risikostatus"@de,
        "Risk status"@en,
        "Statut de risque"@fr,
        "Stato di rischio"@it ;
    schema:description "Einstufung des Seuchenrisikos, z. B. hoch, mittel oder tief"@de,
        "Rating of the disease risk, e.g. high, medium or low"@en,
        "Classification du risque d'épizootie, p. ex. élevé, moyen ou faible"@fr,
        "Classificazione del rischio di epizoozia, p. es. alto, medio o basso"@it .

healthstatustype:LaboratoryResult a schema:CategoryCode ;
    schema:inCodeSet codelist:HealthStatusType ;
    schema:codeValue "LaboratoryResult" ;
    schema:name "Laborergebnis"@de,
        "Laboratory result"@en,
        "Résultat de laboratoire"@fr,
        "Risultato di laboratorio"@it ;
    schema:description "Ergebnis einer Laboruntersuchung, z. B. positiv oder negativ"@de,
        "Result of a laboratory test, e.g. positive or negative"@en,
        "Résultat d'une analyse de laboratoire, p. ex. positif ou négatif"@fr,
        "Risultato di un'analisi di laboratorio, p. es. positivo o negativo"@it .


