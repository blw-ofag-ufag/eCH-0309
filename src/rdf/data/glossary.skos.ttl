# ==============================================================================
# PREFIXES
# ==============================================================================

# Project-specific namespaces/qnames
@prefix :                <https://agriculture.ld.admin.ch/eCH-0309/1/> .
@prefix term:            <https://agriculture.ld.admin.ch/eCH-0309/1/term/> .

# Globally used namespaces/qnames
@prefix schema:          <http://schema.org/> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .

# ==============================================================================
# GLOSSARY METADATA
# ==============================================================================

:glossary a skos:ConceptScheme ;
    schema:name "Glossar des Hilfsmittels eCH-0309"@de,
        "Glossary of eCH-0309"@en,
        "Glossaire de l'eCH-0309"@fr .

# ==============================================================================
# GLOSSARY TERMS
# ==============================================================================

term:lindas a skos:Concept ;
    skos:inScheme :glossary ;
    skos:topConceptOf :glossary ;
    schema:name "Linked Data Service"@de,
        "Linked Data Service"@en,
        "Linked Data Service"@fr ;
    schema:alternateName "LINDAS"@de,
        "LINDAS"@en,
        "LINDAS"@fr ;
    schema:description "Der offizielle Linked-Data-Dienst der Schweizer Bundesverwaltung, der als Triple Store fungiert."@de,
        "The official Linked Data service of the Swiss Federal Administration, acting as a triple store."@en,
        "Le service officiel de données liées de l'administration fédérale suisse, fonctionnant comme un triple store (magasin de triplets)."@fr .

term:rdf a skos:Concept ;
    skos:inScheme :glossary ;
    skos:topConceptOf :glossary ;
    schema:name "Resource Description Framework"@de,
        "Resource Description Framework"@en,
        "Resource Description Framework"@fr ;
    schema:alternateName "RDF"@de,
        "RDF"@en,
        "RDF"@fr ;
    schema:description "Ein zentraler Standard des World Wide Web Consortiums (W3C) zur Modellierung von Datenstrukturen im Web. Informationen werden nicht in klassischen Tabellen, sondern als vernetzte Graphen abgebildet."@de,
        "A central standard of the World Wide Web Consortium (W3C) for modeling data structures on the Web. Information is represented as networked graphs rather than in traditional tables."@en,
        "Une norme centrale du World Wide Web Consortium (W3C) pour la modélisation des structures de données sur le Web. Les informations ne sont pas représentées dans des tableaux classiques, mais sous forme de graphes interconnectés."@fr .

term:triple a skos:Concept ;
    skos:inScheme :glossary ;
    skos:broader term:rdf ;
    schema:name "Tripel"@de,
        "Triple"@en,
        "Triplet"@fr ;
    schema:description "Die Grundstruktur einer Aussage in RDF, bestehend aus Subjekt, Prädikat und Objekt."@de,
        "The basic structure of a statement in RDF, consisting of a subject, predicate, and object."@en,
        "La structure de base d'une déclaration en RDF, composée d'un sujet, d'un prédicat et d'un objet."@fr .

# ==============================================================================
# BEGRIFFE AUS DER SEMANTIKBESCHREIBUNG (Kapitel 3.1 des Hilfsmittels)
#
# Begriffe, die das Hilfsmittel definiert, die aber keine eigene Klasse des
# Datenmodells sind: der Objektkatalog führt sie nicht als Klasse, und für die
# meldende Person hält ein Prüfkommentar fest, dass sie kein öffentlicher
# Bestandteil der Meldung ist.
# ==============================================================================

term:bewirtschafter a skos:Concept ;
    skos:inScheme :glossary ;
    skos:topConceptOf :glossary ;
    schema:name "Bewirtschafter"@de,
        "Farm manager"@en,
        "Exploitant"@fr ;
    schema:description "Eine rechtliche Einheit, die das Geschäftsrisiko für einen Betrieb trägt (LBV Art. 2). Der Tierhaltende ist eine Form des Bewirtschafters, der Tiere hält (LBV Art. 11a)."@de,
        "A legal unit that bears the business risk for a farm (LBV Art. 2). The animal keeper is a form of farm manager that keeps animals (LBV Art. 11a)."@en,
        "Une unité juridique qui assume le risque économique d'une exploitation (OTerm art. 2). Le détenteur d'animaux est une forme d'exploitant qui détient des animaux (OTerm art. 11a)."@fr .

term:meldendePerson a skos:Concept ;
    skos:inScheme :glossary ;
    skos:topConceptOf :glossary ;
    schema:name "Meldende Person"@de,
        "Reporting person"@en,
        "Personne déclarante"@fr ;
    schema:description "Die Person oder die Personen, die für eine Tierhaltung oder für einen Equideneigentümer Meldungen machen."@de,
        "The person or persons who make notifications for an animal holding or for an equid owner."@en,
        "La personne ou les personnes qui effectuent les annonces pour une unité d'élevage ou pour un propriétaire d'équidés."@fr .

term:stammbetrieb a skos:Concept ;
    skos:inScheme :glossary ;
    skos:topConceptOf :glossary ;
    schema:name "Stammbetrieb"@de,
        "Home holding"@en,
        "Exploitation de référence"@fr ;
    schema:description "Bei Rindern kann ein Stammbetrieb hinterlegt werden, um die Zugehörigkeit der Tiere zu einer Tierhaltung abzubilden, wenn sich ein Tier auf einer anderen örtlichen Einheit befindet."@de,
        "For cattle, a home holding can be recorded in order to represent an animal's affiliation to an animal holding while the animal is located on another local unit."@en,
        "Pour les bovins, une exploitation de référence peut être enregistrée afin de représenter l'appartenance des animaux à une unité d'élevage lorsqu'un animal se trouve sur une autre unité locale."@fr .

term:tierhaltung a skos:Concept ;
    skos:inScheme :glossary ;
    skos:topConceptOf :glossary ;
    schema:name "Tierhaltung"@de,
        "Animal holding"@en,
        "Unité d'élevage"@fr ;
    schema:description "In der Tierverkehrsdatenbank werden örtliche Einheiten «Tierhaltungen» genannt; sie sind zusätzlich über die TVD-Nummer identifiziert."@de,
        "In the animal movement database, local units are called «animal holdings»; they are additionally identified by their TVD number."@en,
        "Dans la banque de données sur le trafic des animaux, les unités locales sont appelées «unités d'élevage»; elles sont en outre identifiées par leur numéro BDTA."@fr .

