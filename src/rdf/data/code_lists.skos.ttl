        "Health status of a local unit"@en,
        "État sanitaire de l'unité locale"@fr,
        "Stato sanitario dell'unità locale"@it .

localunithealthstatus:Blocked a skos:Concept, :LocalUnitEpizooticStatus ;
    skos:inScheme localunithealthstatus:ConceptScheme ;
    skos:topConceptOf localunithealthstatus:ConceptScheme ;
    skos:notation "Blocked" ;
    schema:name "gesperrt"@de,
        "Blocked"@en,
        "Bloqué"@fr,
        "Bloccato"@it ;
    schema:description "Typ: Seuchenstatus"@de,
        "Type: epizootic status"@en,
        "Type : statut épizootique"@fr,
        "Tipo: stato epizootico"@it ;
    :sourceTerm "gesperrt" ;
    :animalTracingTerm "FootRotState.Blocked", "BvdState.Blocked" .

localunithealthstatus:Free a skos:Concept, :LocalUnitEpizooticStatus ;
