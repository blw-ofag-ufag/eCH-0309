equidwithersclass:LessOrEqualThan148cm a skos:Concept ;
    skos:inScheme equidwithersclass:ConceptScheme ;
    skos:topConceptOf equidwithersclass:ConceptScheme ;
    skos:notation "LessOrEqualThan148cm" ;
