        "Withers height up to 148 cm"@en,
        "Hauteur au garrot jusqu'à 148 cm"@fr,
        "Altezza al garrese fino a 148 cm"@it ;
    :animalTracingTerm "EnumEquidWithersClass.LessOrEqualThan148cm" .

equidwithersclass:GreaterThan148cm a skos:Concept ;
    skos:inScheme equidwithersclass:ConceptScheme ;
