# Nicht übernommen: Unknow -- nicht in Tabelle 2 aufgeführt.
# Nicht übernommen: Others -- nicht in Tabelle 2 aufgeführt.
# ------------------------------------------------------------------------------

genus:ConceptScheme a skos:ConceptScheme ;
    schema:name "Nutztierart"@de,
        "Genus"@en,
        "Espèce d'animal de rente"@fr,
        "Specie di animale da reddito"@it ;
    :animalTracingTerm "EnumGenus" .

